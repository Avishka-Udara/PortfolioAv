---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Contact from '../components/Contact.astro';
import VisualEffects from '../components/VisualEffects.astro';
import {
  categoryMeta,
  portfolioAssets,
  toEncodedAssetPath,
  type PortfolioCategory
} from '../data/portfolioAssets';

const categories = ['branding', 'logos', '2d', '3d'] as PortfolioCategory[];
const totalVideos = portfolioAssets.filter((asset) => asset.type === 'video').length;
const totalImages = portfolioAssets.filter((asset) => asset.type === 'image').length;
const featuredAssets = categories
  .map((category) => portfolioAssets.find((asset) => asset.category === category))
  .filter(Boolean);
const categoryCounts = Object.fromEntries(
  categories.map((category) => [
    category,
    portfolioAssets.filter((asset) => asset.category === category).length
  ])
);
---

<Layout title="Works Library | Avishka Udara" description="A cinematic archive of branding, logos, 2D motion, 3D renders, and animation work by Avishka Udara.">
    <Navigation />
    <VisualEffects />

    <main class="gallery-shell relative min-h-screen overflow-hidden bg-[#050505] text-white">
        <div class="pointer-events-none absolute inset-0 opacity-80">
            <div class="absolute left-[-10%] top-0 h-[40rem] w-[40rem] rounded-full bg-orange-500/12 blur-[140px]"></div>
            <div class="absolute right-[-8%] top-[18%] h-[34rem] w-[34rem] rounded-full bg-cyan-500/12 blur-[140px]"></div>
            <div class="absolute bottom-[-12%] left-[30%] h-[30rem] w-[30rem] rounded-full bg-fuchsia-500/10 blur-[140px]"></div>
        </div>

        <a href="/" class="fixed left-4 top-5 z-50 flex items-center gap-3 rounded-full border border-white/15 bg-black/45 px-5 py-3 text-sm uppercase tracking-[0.24em] text-white/80 backdrop-blur-xl transition-all duration-300 hover:border-white/40 hover:bg-white hover:text-black md:left-8 md:top-8">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Home</span>
        </a>

        <section class="relative isolate px-4 pb-14 pt-28 md:px-8 md:pb-20 md:pt-36">
            <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:items-end">
                <div>
                    <p class="mb-5 text-xs uppercase tracking-[0.4em] text-white/45">Works Library</p>
                    <h1 class="max-w-4xl font-display text-5xl font-semibold leading-[0.9] text-white md:text-7xl lg:text-[6.5rem]">
                        Every graphic, logo, render, and animation in one live showcase.
                    </h1>
                    <p class="mt-6 max-w-2xl text-base leading-7 text-white/70 md:text-lg">
                        This archive now pulls directly from the real files inside the public library, so the portfolio reflects the full body of work instead of a partial manual list.
                    </p>
                </div>

                <div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-2">
                    <div class="rounded-[2rem] border border-white/10 bg-white/5 p-5 backdrop-blur-xl">
                        <p class="text-xs uppercase tracking-[0.28em] text-white/45">Assets</p>
                        <p class="mt-3 font-display text-4xl text-white">{portfolioAssets.length}</p>
                    </div>
                    <div class="rounded-[2rem] border border-white/10 bg-white/5 p-5 backdrop-blur-xl">
                        <p class="text-xs uppercase tracking-[0.28em] text-white/45">Videos</p>
                        <p class="mt-3 font-display text-4xl text-white">{totalVideos}</p>
                    </div>
                    <div class="rounded-[2rem] border border-white/10 bg-white/5 p-5 backdrop-blur-xl sm:col-span-1 lg:col-span-2">
                        <p class="text-xs uppercase tracking-[0.28em] text-white/45">Stills</p>
                        <p class="mt-3 font-display text-4xl text-white">{totalImages}</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="px-4 md:px-8">
            <div class="mx-auto max-w-7xl">
                <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
                    <div>
                        <p class="text-xs uppercase tracking-[0.3em] text-white/40">Featured Sweep</p>
                        <h2 class="mt-2 font-display text-3xl text-white md:text-4xl">A quick scan across the full visual range.</h2>
                    </div>
                    <div class="filter-buttons flex flex-wrap gap-3">
                        <button class="filter-btn rounded-full border border-white/15 bg-white text-black px-5 py-2.5 text-xs uppercase tracking-[0.28em] transition-all duration-300" data-filter="all">All</button>
                        {categories.map((category) => (
                            <button class="filter-btn rounded-full border border-white/15 bg-white/5 px-5 py-2.5 text-xs uppercase tracking-[0.28em] text-white/75 transition-all duration-300 hover:border-white/35 hover:bg-white hover:text-black" data-filter={category}>
                                {categoryMeta[category].label}
                            </button>
                        ))}
                    </div>
                </div>

                <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
                    {featuredAssets.map((asset) => (
                        <article class={`featured-card relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/5 p-3 backdrop-blur-xl`} data-category={asset.category}>
                            <div class="relative aspect-[4/5] overflow-hidden rounded-[1.4rem] bg-black/60">
                                {asset.type === 'video' ? (
                                    <video
                                        src={toEncodedAssetPath(asset.src)}
                                        class="featured-video h-full w-full object-cover"
                                        muted
                                        loop
                                        playsinline
                                        preload="metadata"
                                        data-autoplay-video
                                    ></video>
                                ) : (
                                    <img
                                        src={toEncodedAssetPath(asset.src)}
                                        alt={asset.alt}
                                        class="h-full w-full object-cover"
                                        loading="lazy"
                                    />
                                )}
                                <div class={`absolute inset-0 bg-gradient-to-t ${categoryMeta[asset.category].accent} opacity-20 mix-blend-screen`}></div>
                            </div>
                            <div class="px-2 pb-2 pt-4">
                                <p class="text-[0.68rem] uppercase tracking-[0.3em] text-white/45">{categoryMeta[asset.category].eyebrow}</p>
                                <h3 class="mt-2 font-display text-2xl text-white">{categoryMeta[asset.category].label}</h3>
                                <p class="mt-2 text-sm leading-6 text-white/65">{categoryMeta[asset.category].description}</p>
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <section class="px-4 py-14 md:px-8 md:py-20">
            <div class="mx-auto max-w-7xl">
                <div class="mb-10 grid gap-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
                    <div>
                        <p class="text-xs uppercase tracking-[0.3em] text-white/40">Archive Grid</p>
                        <h2 class="mt-2 font-display text-4xl text-white md:text-5xl">A cleaner, more reliable gallery wall.</h2>
                    </div>
                    <div class="flex flex-wrap gap-3 text-xs uppercase tracking-[0.24em] text-white/50">
                        {categories.map((category) => (
                            <div class="rounded-full border border-white/10 bg-white/5 px-4 py-2">
                                {categoryMeta[category].label} · {categoryCounts[category]}
                            </div>
                        ))}
                    </div>
                </div>

                <div class="gallery-grid columns-1 gap-6 space-y-6 md:columns-2 xl:columns-3" data-gallery-grid>
                    {portfolioAssets.map((asset) => (
                        <article
                            class={`gallery-card break-inside-avoid rounded-[2rem] border border-white/10 bg-white/[0.04] p-3 shadow-[0_20px_60px_rgba(0,0,0,0.25)] backdrop-blur-xl transition-transform duration-500 hover:-translate-y-1`}
                            data-category={asset.category}
                            data-type={asset.type}
                            data-src={asset.src}
                            data-title={asset.title}
                            data-collection={asset.collection}
                            data-alt={asset.alt}
                        >
                            <div class={`relative overflow-hidden rounded-[1.5rem] bg-black/60 ${asset.category === 'logos' ? 'aspect-[4/3]' : asset.category === '2d' ? 'aspect-[4/5]' : 'aspect-[4/4.8]'}`}>
                                {asset.type === 'video' ? (
                                    <video
                                        src={toEncodedAssetPath(asset.src)}
                                        class="gallery-video h-full w-full object-cover"
                                        muted
                                        loop
                                        playsinline
                                        preload="metadata"
                                        data-autoplay-video
                                    ></video>
                                ) : (
                                    <img
                                        src={toEncodedAssetPath(asset.src)}
                                        alt={asset.alt}
                                        loading="lazy"
                                        class={`gallery-image h-full w-full ${asset.category === 'logos' ? 'object-contain p-8' : 'object-cover'} transition-transform duration-700 group-hover:scale-105`}
                                    />
                                )}

                                <div class="media-error pointer-events-none absolute inset-0 hidden items-center justify-center bg-gradient-to-br from-zinc-950 to-black text-center text-white/55">
                                    <div class="px-6">
                                        <p class="text-xs uppercase tracking-[0.26em]">Media unavailable</p>
                                        <p class="mt-2 text-sm text-white/35">{asset.filename}</p>
                                    </div>
                                </div>

                                <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black via-black/15 to-transparent opacity-90"></div>
                                <div class={`pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t ${categoryMeta[asset.category].accent} opacity-20 blur-2xl`}></div>

                                {asset.type === 'video' ? (
                                    <div class="pointer-events-none absolute right-4 top-4 rounded-full border border-white/15 bg-black/45 px-3 py-1.5 text-[0.64rem] uppercase tracking-[0.28em] text-white/70 backdrop-blur-xl">
                                        Motion
                                    </div>
                                ) : (
                                    <div class="pointer-events-none absolute right-4 top-4 rounded-full border border-white/15 bg-black/45 px-3 py-1.5 text-[0.64rem] uppercase tracking-[0.28em] text-white/70 backdrop-blur-xl">
                                        Still
                                    </div>
                                )}
                            </div>

                            <div class="flex items-end justify-between gap-4 px-1 pb-2 pt-4">
                                <div>
                                    <p class="text-[0.68rem] uppercase tracking-[0.3em] text-white/40">{asset.collection}</p>
                                    <h3 class="mt-2 font-display text-2xl leading-tight text-white">{asset.title}</h3>
                                </div>
                                <span class="shrink-0 text-[0.68rem] uppercase tracking-[0.3em] text-white/35">{categoryMeta[asset.category].label}</span>
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        </section>
    </main>

    <div id="lightbox" class="fixed inset-0 z-[100] hidden bg-black/95 opacity-0 transition-opacity duration-300">
        <button id="lightbox-close" class="fixed right-5 top-5 z-[102] rounded-full border border-white/15 bg-black/50 p-3 text-white/70 backdrop-blur-xl transition-colors hover:text-white md:right-8 md:top-8">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>

        <button id="lightbox-prev" class="fixed left-3 top-1/2 z-[102] -translate-y-1/2 rounded-full border border-white/10 bg-black/45 p-3 text-white/55 backdrop-blur-xl transition-all hover:text-white md:left-8">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
        </button>

        <button id="lightbox-next" class="fixed right-3 top-1/2 z-[102] -translate-y-1/2 rounded-full border border-white/10 bg-black/45 p-3 text-white/55 backdrop-blur-xl transition-all hover:text-white md:right-8">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
        </button>

        <div class="flex h-full w-full items-center justify-center px-4 py-20 md:px-10">
            <div class="grid w-full max-w-7xl gap-6 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-end">
                <div id="lightbox-content" class="relative flex min-h-[40vh] items-center justify-center overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.04] p-3 backdrop-blur-2xl"></div>
                <div class="rounded-[2rem] border border-white/10 bg-white/[0.04] p-6 backdrop-blur-2xl">
                    <p id="lightbox-category" class="text-[0.68rem] uppercase tracking-[0.3em] text-white/45"></p>
                    <h3 id="lightbox-title" class="mt-3 font-display text-3xl text-white"></h3>
                    <p id="lightbox-collection" class="mt-3 text-sm leading-6 text-white/65"></p>
                    <div class="mt-8 flex items-center justify-between text-xs uppercase tracking-[0.28em] text-white/40">
                        <span id="lightbox-position">1 / 1</span>
                        <span>Esc to close</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <Contact />
</Layout>

<script define:vars={{ categoryMeta }}>
    const buttons = Array.from(document.querySelectorAll('.filter-btn'));
    const cards = Array.from(document.querySelectorAll('.gallery-card'));
    const featuredCards = Array.from(document.querySelectorAll('.featured-card'));
    const autoVideos = Array.from(document.querySelectorAll('[data-autoplay-video]'));

    const lightbox = document.getElementById('lightbox');
    const lightboxContent = document.getElementById('lightbox-content');
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxPrev = document.getElementById('lightbox-prev');
    const lightboxNext = document.getElementById('lightbox-next');
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxCategory = document.getElementById('lightbox-category');
    const lightboxCollection = document.getElementById('lightbox-collection');
    const lightboxPosition = document.getElementById('lightbox-position');

    let visibleCards = [];
    let currentIndex = 0;

    function setButtonState(activeFilter) {
        buttons.forEach((button) => {
            const isActive = button.dataset.filter === activeFilter;
            button.classList.toggle('bg-white', isActive);
            button.classList.toggle('text-black', isActive);
            button.classList.toggle('bg-white/5', !isActive);
            button.classList.toggle('text-white/75', !isActive);
        });
    }

    function filterGallery(category) {
        cards.forEach((card) => {
            const matches = category === 'all' || card.dataset.category === category;
            card.style.display = matches ? 'block' : 'none';
        });

        featuredCards.forEach((card) => {
            const matches = category === 'all' || card.dataset.category === category;
            card.style.display = matches ? 'block' : 'none';
        });

        visibleCards = cards.filter((card) => card.style.display !== 'none');
        setButtonState(category);
        syncVisibleVideos();
    }

    function syncVisibleVideos() {
        autoVideos.forEach((video) => {
            const card = video.closest('.gallery-card, .featured-card');
            if (!card || card.style.display === 'none') {
                video.pause();
                return;
            }

            const bounds = card.getBoundingClientRect();
            const inView = bounds.bottom > 80 && bounds.top < window.innerHeight - 80;

            if (inView) {
                video.play().catch(() => {});
            } else {
                video.pause();
            }
        });
    }

    function setupMediaFallbacks() {
        document.querySelectorAll('.gallery-video, .featured-video').forEach((video) => {
            video.addEventListener('error', () => {
                const errorState = video.closest('.gallery-card, .featured-card')?.querySelector('.media-error');
                video.classList.add('hidden');
                if (errorState) {
                    errorState.classList.remove('hidden');
                    errorState.classList.add('flex');
                }
            });

            video.addEventListener('loadeddata', () => {
                video.play().catch(() => {});
            });
        });

        document.querySelectorAll('.gallery-image').forEach((image) => {
            image.addEventListener('error', () => {
                const errorState = image.closest('.gallery-card')?.querySelector('.media-error');
                image.classList.add('hidden');
                if (errorState) {
                    errorState.classList.remove('hidden');
                    errorState.classList.add('flex');
                }
            });
        });
    }

    function encodedPath(src) {
        return src
            .split('/')
            .map((segment, index) => (index === 0 ? segment : encodeURIComponent(segment)))
            .join('/');
    }

    function updateLightbox(index) {
        const asset = visibleCards[index];
        if (!asset) {
            return;
        }

        currentIndex = index;
        lightboxContent.innerHTML = '';

        const type = asset.dataset.type;
        const src = asset.dataset.src;
        const title = asset.dataset.title || '';
        const category = asset.dataset.category || 'branding';
        const collection = asset.dataset.collection || '';
        const alt = asset.dataset.alt || title;

        if (type === 'video') {
            const frame = document.createElement('div');
            frame.className = 'flex h-full w-full items-center justify-center';

            const video = document.createElement('video');
            video.src = encodedPath(src);
            video.controls = true;
            video.autoplay = true;
            video.playsInline = true;
            video.className = 'max-h-[78vh] w-full rounded-[1.4rem] object-contain';

            frame.appendChild(video);
            lightboxContent.appendChild(frame);
        } else {
            const image = document.createElement('img');
            image.src = encodedPath(src);
            image.alt = alt;
            image.className = 'max-h-[78vh] w-full rounded-[1.4rem] object-contain';
            lightboxContent.appendChild(image);
        }

        lightboxTitle.textContent = title;
        lightboxCategory.textContent = categoryMeta[category].label;
        lightboxCollection.textContent = collection;
        lightboxPosition.textContent = `${index + 1} / ${visibleCards.length}`;

        lightboxPrev.style.opacity = index === 0 ? '0.35' : '1';
        lightboxPrev.style.pointerEvents = index === 0 ? 'none' : 'auto';
        lightboxNext.style.opacity = index === visibleCards.length - 1 ? '0.35' : '1';
        lightboxNext.style.pointerEvents = index === visibleCards.length - 1 ? 'none' : 'auto';
    }

    function openLightbox(index) {
        updateLightbox(index);
        lightbox.classList.remove('hidden');
        requestAnimationFrame(() => {
            lightbox.classList.remove('opacity-0');
        });
        document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
        lightbox.classList.add('opacity-0');
        window.setTimeout(() => {
            lightbox.classList.add('hidden');
            lightboxContent.innerHTML = '';
        }, 250);
        document.body.style.overflow = '';
    }

    function moveLightbox(direction) {
        const nextIndex = currentIndex + direction;
        if (nextIndex < 0 || nextIndex >= visibleCards.length) {
            return;
        }

        updateLightbox(nextIndex);
    }

    const params = new URLSearchParams(window.location.search);
    const initialCategory = params.get('category') || 'all';

    buttons.forEach((button) => {
        button.addEventListener('click', () => {
            const filter = button.dataset.filter || 'all';
            filterGallery(filter);

            const url = new URL(window.location.href);
            url.searchParams.set('category', filter);
            window.history.replaceState({}, '', url);
        });
    });

    cards.forEach((card) => {
        card.addEventListener('click', () => {
            const index = visibleCards.indexOf(card);
            if (index !== -1) {
                openLightbox(index);
            }
        });
    });

    lightboxClose?.addEventListener('click', closeLightbox);
    lightboxPrev?.addEventListener('click', () => moveLightbox(-1));
    lightboxNext?.addEventListener('click', () => moveLightbox(1));

    lightbox?.addEventListener('click', (event) => {
        if (event.target === lightbox) {
            closeLightbox();
        }
    });

    document.addEventListener('keydown', (event) => {
        if (lightbox?.classList.contains('hidden')) {
            return;
        }

        if (event.key === 'Escape') {
            closeLightbox();
        } else if (event.key === 'ArrowLeft') {
            moveLightbox(-1);
        } else if (event.key === 'ArrowRight') {
            moveLightbox(1);
        }
    });

    window.addEventListener('scroll', syncVisibleVideos, { passive: true });
    window.addEventListener('resize', syncVisibleVideos);

    setupMediaFallbacks();
    filterGallery(initialCategory);
</script>

<style>
    .gallery-shell {
        background-image:
            linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
            linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
        background-position: center;
        background-size: 80px 80px;
    }

    .gallery-card,
    .featured-card {
        animation: rise-in 0.7s ease both;
    }

    @keyframes rise-in {
        from {
            opacity: 0;
            transform: translateY(24px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
