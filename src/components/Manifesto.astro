---
---

<section id="manifesto" class="relative min-h-screen overflow-hidden px-4 pb-14 pt-28 md:px-8 md:pb-18 md:pt-32">
    <div class="manifesto-bg absolute inset-0 -z-10"></div>
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_20%,rgba(255,255,255,0.08),transparent_35%),linear-gradient(180deg,rgba(255,255,255,0.03),transparent_30%)]"></div>

    <div class="absolute left-0 right-0 top-12 z-20 text-center opacity-0 personal-brand">
        <p class="font-body text-xs font-light uppercase tracking-[0.32em] text-neutral-400 md:text-sm">
            Avishka Udara | Motion Designer, Brand Visual Designer, 3D Storyteller
        </p>
    </div>

    <a href="https://drive.google.com/drive/folders/194GPtlevcTmcmE1zUH7hi3UdejsmO-fp?usp=sharing" target="_blank" rel="noopener noreferrer" class="gdrive-cta-wrapper fixed left-4 top-5 z-50 opacity-0 md:left-8 md:top-8">
        <div class="gdrive-cta group relative">
            <div class="particle particle-1 absolute h-2 w-2 rounded-full bg-blue-500/60"></div>
            <div class="particle particle-2 absolute h-2 w-2 rounded-full bg-blue-500/60"></div>
            <div class="particle particle-3 absolute h-2 w-2 rounded-full bg-blue-500/60"></div>
            
            <div class="relative flex items-center gap-3 overflow-hidden rounded-full border border-white/20 bg-black/60 px-4 py-3 backdrop-blur-xl transition-all duration-500 group-hover:scale-105 group-hover:border-blue-500 group-hover:bg-blue-500/10">
                <div class="absolute inset-0 rounded-full bg-blue-500/30 scale-0 opacity-0 blur-md transition-all duration-700 group-hover:scale-150 group-hover:opacity-100"></div>
                
                <div class="relative flex items-center gap-3">
                    <svg class="h-6 w-6 flex-shrink-0 text-white transition-colors group-hover:text-blue-400" viewBox="0 0 87.3 78" xmlns="http://www.w3.org/2000/svg">
                        <path d="m6.6 66.85 3.85 6.65c.8 1.4 1.95 2.5 3.3 3.3l13.75-23.8h-27.5c0 1.55.4 3.1 1.2 4.5z" fill="currentColor"/>
                        <path d="m43.65 25-13.75-23.8c-1.35.8-2.5 1.9-3.3 3.3l-25.4 44a9.06 9.06 0 0 0 -1.2 4.5h27.5z" fill="currentColor"/>
                        <path d="m73.55 76.8c1.35-.8 2.5-1.9 3.3-3.3l1.6-2.75 7.65-13.25c.8-1.4 1.2-2.95 1.2-4.5h-27.502l5.852 11.5z" fill="currentColor"/>
                        <path d="m43.65 25 13.75-23.8c-1.35-.8-2.9-1.2-4.5-1.2h-18.5c-1.6 0-3.15.45-4.5 1.2z" fill="currentColor"/>
                        <path d="m59.8 53h-32.3l-13.75 23.8c1.35.8 2.9 1.2 4.5 1.2h50.8c1.6 0 3.15-.45 4.5-1.2z" fill="currentColor"/>
                    </svg>
                    <span class="gdrive-text font-body text-xs font-medium uppercase tracking-[0.2em] text-white transition-all duration-500 group-hover:ml-1 group-hover:max-w-xs group-hover:text-blue-400 whitespace-nowrap max-w-0 overflow-hidden">
                        View Works Archive
                    </span>
                </div>
            </div>
        </div>
    </a>
    
    <a href="/gallery" class="gallery-cta-wrapper fixed right-4 top-5 z-50 opacity-0 md:right-8 md:top-8">
        <div class="gallery-cta group relative">
            <div class="particle particle-1 absolute h-2 w-2 rounded-full bg-red-500/60"></div>
            <div class="particle particle-2 absolute h-2 w-2 rounded-full bg-red-500/60"></div>
            <div class="particle particle-3 absolute h-2 w-2 rounded-full bg-red-500/60"></div>
            
            <div class="relative flex items-center gap-3 rounded-full border border-white/20 bg-black/60 px-6 py-3 backdrop-blur-xl transition-all duration-500 group-hover:scale-105 group-hover:border-red-500 group-hover:bg-red-500/10">
                <div class="absolute inset-0 rounded-full bg-red-500/30 scale-0 opacity-0 blur-md transition-all duration-700 group-hover:scale-150 group-hover:opacity-100"></div>
                
                <div class="relative flex items-center gap-3">
                    <div class="relative h-6 w-6">
                        <div class="absolute inset-0 animate-pulse rounded-full bg-gradient-to-br from-red-500 to-red-600"></div>
                        <div class="absolute inset-0.5 flex items-center justify-center rounded-full bg-black">
                            <div class="h-2 w-2 rounded-full bg-red-500 group-hover:animate-ping"></div>
                        </div>
                    </div>
                    
                    <span class="cta-text font-body text-xs font-medium uppercase tracking-[0.2em] text-white transition-colors group-hover:text-red-400">
                        View My Works
                    </span>
                    
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-white/60 transition-all group-hover:translate-x-1 group-hover:text-red-500">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </div>
            </div>
        </div>
    </a>

    <div class="mx-auto flex min-h-[calc(100vh-7rem)] max-w-7xl items-center">
        <div class="manifesto-shell relative z-10 grid w-full gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(18rem,0.9fr)] lg:items-end">
            <div class="manifesto-copy text-left">
                <p class="mb-5 text-xs uppercase tracking-[0.38em] text-white/40">Design That Converts Attention Into Trust</p>

                <div class="manifesto-content manifesto-set-1 relative">
                    <h1 class="manifesto-line font-display text-[15vw] font-black uppercase leading-[0.84] tracking-[-0.06em] text-white md:text-[7rem] lg:text-[8.8rem]">
                        <span class="glitch-text" data-text="I Build">I Build</span>
                    </h1>
                    <h1 class="manifesto-line font-display text-[15vw] font-black uppercase leading-[0.84] tracking-[-0.06em] text-white md:text-[7rem] lg:text-[8.8rem]">
                        <span class="glitch-text" data-text="Visual Systems">Visual Systems</span>
                    </h1>
                    <h2 class="manifesto-sub mt-5 max-w-4xl font-display text-[7vw] font-bold uppercase leading-[0.92] tracking-tight text-neutral-300 md:text-[2.8rem] lg:text-[3.5rem]">
                        <span class="word">That</span> <span class="word">help</span> <span class="word">brands</span> <span class="word">look</span> <span class="word">premium</span> <span class="word">and</span> <span class="word">move</span> <span class="word">with</span> <span class="word">clarity.</span>
                    </h2>
                </div>

                <div class="manifesto-content manifesto-set-2 absolute inset-0 opacity-0">
                    <h1 class="manifesto-line-alt font-display text-[15vw] font-black uppercase leading-[0.84] tracking-[-0.06em] text-white md:text-[7rem] lg:text-[8.8rem]">
                        <span class="glitch-text" data-text="I Turn">I Turn</span>
                    </h1>
                    <h1 class="manifesto-line-alt font-display text-[15vw] font-black uppercase leading-[0.84] tracking-[-0.06em] text-white md:text-[7rem] lg:text-[8.8rem]">
                        <span class="glitch-text" data-text="Ideas Into Motion">Ideas Into Motion</span>
                    </h1>
                    <h2 class="manifesto-sub-alt mt-5 max-w-4xl font-display text-[7vw] font-bold uppercase leading-[0.92] tracking-tight text-neutral-300 md:text-[2.8rem] lg:text-[3.5rem]">
                        <span class="word-alt">For</span> <span class="word-alt">healthcare,</span> <span class="word-alt">fintech,</span> <span class="word-alt">exports,</span> <span class="word-alt">NGOs,</span> <span class="word-alt">and</span> <span class="word-alt">growing</span> <span class="word-alt">businesses.</span>
                    </h2>
                </div>

                <p class="hero-support mt-8 max-w-2xl text-base leading-7 text-white/68 md:text-lg">
                    I help companies communicate better through branding, social visuals, 2D motion, 3D presentation, and campaign design that feels cinematic, strategic, and built to earn trust.
                </p>

                <div class="mt-8 flex flex-wrap gap-3">
                    <a href="#services" class="rounded-full border border-white/15 bg-white px-6 py-3 text-xs font-medium uppercase tracking-[0.28em] text-black transition-all duration-300 hover:scale-[1.02] hover:bg-red-500 hover:text-white">
                        Explore Services
                    </a>
                    <a href="#contact" class="rounded-full border border-white/15 bg-white/5 px-6 py-3 text-xs font-medium uppercase tracking-[0.28em] text-white transition-all duration-300 hover:border-white/30 hover:bg-white hover:text-black">
                        Start a Project
                    </a>
                </div>
            </div>

            <div class="hero-proof-panel rounded-[2rem] border border-white/10 bg-white/[0.04] p-5 backdrop-blur-2xl">
                <div class="grid gap-4 sm:grid-cols-2">
                    <div class="rounded-[1.4rem] border border-white/10 bg-black/45 p-5">
                        <p class="text-xs uppercase tracking-[0.28em] text-white/38">Experience</p>
                        <p class="mt-3 font-display text-4xl text-white">9+ Years</p>
                        <p class="mt-2 text-sm leading-6 text-white/55">Long-term visual support across healthcare, tech, fintech, NGOs, and product brands.</p>
                    </div>
                    <div class="rounded-[1.4rem] border border-white/10 bg-black/45 p-5">
                        <p class="text-xs uppercase tracking-[0.28em] text-white/38">Focus</p>
                        <p class="mt-3 font-display text-4xl text-white">Brand + Motion</p>
                        <p class="mt-2 text-sm leading-6 text-white/55">Identity systems, campaign creatives, animated promos, and dimensional presentation work.</p>
                    </div>
                </div>
                <div class="mt-4 rounded-[1.5rem] border border-white/10 bg-gradient-to-br from-white/[0.06] to-white/[0.02] p-5">
                    <p class="text-xs uppercase tracking-[0.28em] text-red-400/80">Outcome</p>
                    <p class="mt-3 font-display text-2xl text-white md:text-3xl">Sharper brands. Clearer communication. More memorable launches.</p>
                </div>
            </div>
        </div>
    </div>
    
    <div class="scroll-hint absolute bottom-10 left-0 right-0 text-center opacity-0">
        <p class="font-body text-sm uppercase tracking-widest text-neutral-500">Scroll to Begin</p>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    
    function splitText(element) {
        const text = element.textContent || '';
        const chars = text.split('');
        element.innerHTML = chars.map((char) =>
            `<span class="char" style="display:inline-block; opacity:0;">${char === ' ' ? '&nbsp;' : char}</span>`
        ).join('');
    }

    document.querySelectorAll('.manifesto-sub .word, .manifesto-sub-alt .word-alt').forEach((word) => {
        splitText(word);
    });

    const tl = gsap.timeline({ defaults: { ease: "power4.out" } });

    tl.to(".personal-brand", {
        opacity: 1,
        y: 0,
        duration: 1.1,
        delay: 0.2
    })
    .to(".manifesto-line", {
        opacity: 1,
        duration: 0.01,
        stagger: 0
    })
    .to(".manifesto-line", {
        y: 0,
        duration: 1.35,
        stagger: 0.2,
        delay: 0.15
    })
    .to(".manifesto-sub .char", {
        opacity: 1,
        y: 0,
        rotation: 0,
        duration: 0.55,
        stagger: 0.015,
        ease: "back.out(1.7)"
    }, "-=0.7")
    .from(".hero-support, .hero-proof-panel", {
        opacity: 0,
        y: 30,
        duration: 0.9,
        stagger: 0.12
    }, "-=0.55")
    .to(".scroll-hint", {
        opacity: 1,
        duration: 1,
        y: 10,
        repeat: -1,
        yoyo: true,
        ease: "power1.inOut"
    })
    .to(".gallery-cta-wrapper", {
        opacity: 1,
        y: -10,
        duration: 1.2,
        ease: "power3.out"
    }, "-=0.9")
    .to(".gdrive-cta-wrapper", {
        opacity: 1,
        y: -10,
        duration: 1.2,
        ease: "power3.out"
    }, "-=1");
    
    const ctaButton = document.querySelector('.gallery-cta');
    if (ctaButton) {
        ctaButton.addEventListener('mousemove', (e) => {
            const rect = ctaButton.getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;
            
            gsap.to(ctaButton, {
                x: x * 0.24,
                y: y * 0.24,
                duration: 0.45,
                ease: 'power2.out'
            });
        });
        
        ctaButton.addEventListener('mouseleave', () => {
            gsap.to(ctaButton, {
                x: 0,
                y: 0,
                duration: 0.8,
                ease: 'elastic.out(1, 0.5)'
            });
        });
    }
    
    const gdriveButton = document.querySelector('.gdrive-cta');
    if (gdriveButton) {
        gdriveButton.addEventListener('mousemove', (e) => {
            const rect = gdriveButton.getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;
            
            gsap.to(gdriveButton, {
                x: x * 0.24,
                y: y * 0.24,
                duration: 0.45,
                ease: 'power2.out'
            });
        });
        
        gdriveButton.addEventListener('mouseleave', () => {
            gsap.to(gdriveButton, {
                x: 0,
                y: 0,
                duration: 0.8,
                ease: 'elastic.out(1, 0.5)'
            });
        });
    }
    
    function glitchEffect(element) {
        const glitchTl = gsap.timeline();
        
        glitchTl.to(element, {
            textShadow: '5px 0 0 #ff0000, -5px 0 0 #00ffff',
            skewX: 10,
            duration: 0.05,
        })
        .to(element, {
            textShadow: '-5px 0 0 #ff0000, 5px 0 0 #00ffff',
            skewX: -10,
            duration: 0.05,
        })
        .to(element, {
            textShadow: '3px 3px 0 #ff0000, -3px -3px 0 #00ffff',
            skewX: 5,
            duration: 0.05,
        })
        .to(element, {
            textShadow: 'none',
            skewX: 0,
            duration: 0.1,
        });
        
        return glitchTl;
    }
    
    let currentSet = 1;
    let textSwitchInterval = null;
    
    function switchText() {
        const set1 = document.querySelector('.manifesto-set-1');
        const set2 = document.querySelector('.manifesto-set-2');
        
        if (currentSet === 1) {
            set1?.querySelectorAll('.glitch-text').forEach((el) => glitchEffect(el));
            
            gsap.to(set1, {
                opacity: 0,
                scale: 0.97,
                filter: 'blur(5px)',
                duration: 0.45,
                ease: "power2.in"
            });

            gsap.set(".manifesto-line-alt", { opacity: 1, y: 0 });
            
            gsap.to(set2, {
                opacity: 1,
                scale: 1,
                filter: 'blur(0px)',
                duration: 0.45,
                delay: 0.25,
                ease: "power2.out",
                onStart: () => {
                    set2?.querySelectorAll('.glitch-text').forEach((el) => glitchEffect(el));
                }
            });
            
            gsap.fromTo(".manifesto-sub-alt .char",
                { opacity: 0, y: 20 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.5,
                    stagger: 0.015,
                    delay: 0.35,
                    ease: "back.out(1.7)"
                }
            );
            
            currentSet = 2;
        } else {
            set2?.querySelectorAll('.glitch-text').forEach((el) => glitchEffect(el));
            
            gsap.to(set2, {
                opacity: 0,
                scale: 0.97,
                filter: 'blur(5px)',
                duration: 0.45,
                ease: "power2.in"
            });
            
            gsap.set(".manifesto-line", { opacity: 1, y: 0 });
            
            gsap.to(set1, {
                opacity: 1,
                scale: 1,
                filter: 'blur(0px)',
                duration: 0.45,
                delay: 0.25,
                ease: "power2.out",
                onStart: () => {
                    set1?.querySelectorAll('.glitch-text').forEach((el) => glitchEffect(el));
                }
            });
            
            gsap.fromTo(".manifesto-sub .char",
                { opacity: 0, y: 20 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.5,
                    stagger: 0.015,
                    delay: 0.35,
                    ease: "back.out(1.7)"
                }
            );
            
            currentSet = 1;
        }
    }
    
    function startTextSwitcher() {
        if (textSwitchInterval === null) {
            textSwitchInterval = setInterval(switchText, 10000);
        }
    }
    
    function stopTextSwitcher() {
        if (textSwitchInterval !== null) {
            clearInterval(textSwitchInterval);
            textSwitchInterval = null;
        }
    }
    
    function handleVisibilityChange() {
        if (document.hidden) {
            stopTextSwitcher();
            gsap.globalTimeline.pause();
        } else {
            gsap.globalTimeline.resume();
            const set1 = document.querySelector('.manifesto-set-1');
            const set2 = document.querySelector('.manifesto-set-2');
            
            gsap.set(set1, { opacity: 1, scale: 1, filter: 'blur(0px)' });
            gsap.set(set2, { opacity: 0, scale: 0.97, filter: 'blur(5px)' });
            gsap.set(".manifesto-line", { opacity: 1, y: 0 });
            gsap.set(".manifesto-sub .char", { opacity: 1, y: 0, rotation: 0 });
            
            currentSet = 1;
            startTextSwitcher();
        }
    }
    
    document.addEventListener('visibilitychange', handleVisibilityChange);
    startTextSwitcher();
    
    document.querySelectorAll('.glitch-text').forEach((el) => {
        el.addEventListener('mouseenter', () => {
            glitchEffect(el);
        });
    });
    
    const container = document.getElementById('manifesto');
    if (container) {
        container.addEventListener('mousemove', (e) => {
            const xPos = (e.clientX / window.innerWidth - 0.5) * 24;
            const yPos = (e.clientY / window.innerHeight - 0.5) * 24;
            
            gsap.to('.manifesto-copy', {
                x: xPos,
                y: yPos,
                duration: 1,
                ease: 'power2.out'
            });
        });
    }
</script>

<style>
    .manifesto-line,
    .manifesto-line-alt {
        opacity: 0;
        transform: translateY(50px);
        will-change: transform, opacity;
    }
    
    .char {
        transform: translateY(20px) rotate(-5deg);
        will-change: transform, opacity;
    }
    
    .glitch-text {
        position: relative;
        display: inline-block;
        transition: all 0.1s;
    }
    
    .manifesto-bg {
        background:
            radial-gradient(circle at 50% 50%, rgba(255, 51, 51, 0.08) 0%, transparent 40%),
            radial-gradient(circle at 80% 20%, rgba(0, 215, 255, 0.08) 0%, transparent 32%);
    }
    
    .manifesto-set-2 {
        pointer-events: none;
    }
    
    .gallery-cta-wrapper,
    .gdrive-cta-wrapper {
        animation: float 3s ease-in-out infinite;
        transition: opacity 0.6s ease, transform 0.6s ease;
    }
    
    @keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
    }
    
    .gallery-cta,
    .gdrive-cta {
        cursor: pointer;
        position: relative;
    }
    
    .gdrive-text {
        transition: max-width 0.5s cubic-bezier(0.4, 0, 0.2, 1), margin-left 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
        opacity: 0;
    }
    
    .gdrive-cta:hover .gdrive-text {
        opacity: 1;
    }
    
    .particle {
        animation: particle-float 4s ease-in-out infinite;
        opacity: 0;
    }
    
    .particle-1 {
        top: -15px;
        right: -10px;
        animation-delay: 0s;
    }
    
    .particle-2 {
        top: -20px;
        right: 20px;
        animation-delay: 1.5s;
    }
    
    .particle-3 {
        top: -10px;
        right: 40px;
        animation-delay: 3s;
    }
    
    @keyframes particle-float {
        0% {
            opacity: 0;
            transform: translateY(0) scale(1);
        }
        20% {
            opacity: 1;
        }
        100% {
            opacity: 0;
            transform: translateY(-30px) scale(0);
        }
    }
    
    .gallery-cta:hover .particle,
    .gdrive-cta:hover .particle {
        animation-duration: 2s;
    }
</style>
