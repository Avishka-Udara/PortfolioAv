---
---

<section id="manifesto" class="relative min-h-screen flex flex-col justify-center items-center px-4 overflow-hidden">
    
    <div class="manifesto-bg absolute inset-0 -z-10"></div>

    <div class="absolute top-12 left-0 right-0 text-center z-20 opacity-0 personal-brand">
        <p class="font-body text-xs md:text-sm uppercase tracking-[0.3em] text-neutral-400 font-light">
            Avishka Udara | Motion Designer, Brand Visual Designer, 3D Storyteller
        </p>
    </div>

    <div class="manifesto-content manifesto-set-1 relative z-10 text-center mix-blend-difference max-w-[92vw]">
        <p class="manifesto-kicker mb-6 font-body text-[0.72rem] md:text-xs uppercase tracking-[0.38em] text-neutral-500">
            Design that converts attention into trust
        </p>

        <h1 class="manifesto-line font-display text-[10vw] md:text-[9vw] font-black leading-[0.85] tracking-tighter uppercase text-white">
            <span class="glitch-text" data-text="I Don't Design">I Don't Design</span>
        </h1>
        <h1 class="manifesto-line font-display text-[10vw] md:text-[9vw] font-black leading-[0.85] tracking-tighter uppercase text-white">
            <span class="glitch-text" data-text="Frames">Frames</span>
        </h1>
        <div class="h-9 md:h-24"></div>
        <h2 class="manifesto-sub font-display text-[6vw] md:text-[5vw] font-bold leading-[0.9] tracking-tight uppercase text-neutral-400">
            <span class="word">I</span> <span class="word">Design</span> <span class="word">Moments</span> <span class="word">That</span> <span class="word">Move</span>
        </h2>

        <p class="hero-support mx-auto mt-8 max-w-3xl font-body text-sm md:text-base text-neutral-400 leading-relaxed">
            I help brands communicate with more clarity through identity, motion, and visual systems built for real campaigns, products, and long-term growth.
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
            <a href="#services" class="rounded-full bg-white px-6 py-3 text-xs font-medium uppercase tracking-[0.24em] text-black transition-all duration-300 hover:bg-red-500 hover:text-white">
                Explore Services
            </a>
            <a href="#contact" class="rounded-full border border-white/20 bg-black/20 px-6 py-3 text-xs font-medium uppercase tracking-[0.24em] text-white transition-all duration-300 hover:border-white/40 hover:bg-white hover:text-black">
                Start a Project
            </a>
        </div>
    </div>
    
    <div class="manifesto-content manifesto-set-2 absolute inset-0 flex flex-col justify-center items-center z-10 text-center mix-blend-difference opacity-0 max-w-[92vw] mx-auto">
        <p class="manifesto-kicker mb-6 font-body text-[0.72rem] md:text-xs uppercase tracking-[0.38em] text-neutral-500">
            9+ years across healthcare, fintech, NGOs, exports, and product brands
        </p>

        <h1 class="manifesto-line-alt font-display text-[10vw] md:text-[9vw] font-black leading-[0.85] tracking-tighter uppercase text-white">
            <span class="glitch-text" data-text="I Don't Create">I Don't Create</span>
        </h1>
        <h1 class="manifesto-line-alt font-display text-[10vw] md:text-[9vw] font-black leading-[0.85] tracking-tighter uppercase text-white">
            <span class="glitch-text" data-text="Visuals">Visuals</span>
        </h1>
        <div class="h-9 md:h-24"></div>
        <h2 class="manifesto-sub-alt font-display text-[6vw] md:text-[5vw] font-bold leading-[0.9] tracking-tight uppercase text-neutral-400">
            <span class="word-alt">I</span> <span class="word-alt">Shape</span> <span class="word-alt">Perception</span>
        </h2>

        <p class="hero-support-alt mx-auto mt-8 max-w-3xl font-body text-sm md:text-base text-neutral-400 leading-relaxed">
            Branding, motion graphics, campaign visuals, and 3D presentation work for businesses that need consistency and stronger visual trust.
        </p>
    </div>
    
    <a href="https://drive.google.com/drive/folders/194GPtlevcTmcmE1zUH7hi3UdejsmO-fp?usp=sharing" target="_blank" rel="noopener noreferrer" class="gdrive-cta-wrapper fixed top-8 left-8 z-50 opacity-0">
        <div class="gdrive-cta group relative">
            <div class="particle particle-1 absolute w-2 h-2 rounded-full bg-blue-500/60"></div>
            <div class="particle particle-2 absolute w-2 h-2 rounded-full bg-blue-500/60"></div>
            <div class="particle particle-3 absolute w-2 h-2 rounded-full bg-blue-500/60"></div>
            
            <div class="relative flex items-center gap-3 px-4 py-3 bg-black/60 backdrop-blur-xl rounded-full border border-white/20 group-hover:border-blue-500 group-hover:bg-blue-500/10 transition-all duration-500 group-hover:scale-105 overflow-hidden">
                <div class="absolute inset-0 rounded-full bg-blue-500/30 scale-0 group-hover:scale-150 opacity-0 group-hover:opacity-100 blur-md transition-all duration-700"></div>
                
                <div class="relative flex items-center gap-3">
                    <svg class="w-6 h-6 flex-shrink-0 text-white transition-colors group-hover:text-blue-400" viewBox="0 0 87.3 78" xmlns="http://www.w3.org/2000/svg">
                        <path d="m6.6 66.85 3.85 6.65c.8 1.4 1.95 2.5 3.3 3.3l13.75-23.8h-27.5c0 1.55.4 3.1 1.2 4.5z" fill="currentColor"/>
                        <path d="m43.65 25-13.75-23.8c-1.35.8-2.5 1.9-3.3 3.3l-25.4 44a9.06 9.06 0 0 0 -1.2 4.5h27.5z" fill="currentColor"/>
                        <path d="m73.55 76.8c1.35-.8 2.5-1.9 3.3-3.3l1.6-2.75 7.65-13.25c.8-1.4 1.2-2.95 1.2-4.5h-27.502l5.852 11.5z" fill="currentColor"/>
                        <path d="m43.65 25 13.75-23.8c-1.35-.8-2.9-1.2-4.5-1.2h-18.5c-1.6 0-3.15.45-4.5 1.2z" fill="currentColor"/>
                        <path d="m59.8 53h-32.3l-13.75 23.8c1.35.8 2.9 1.2 4.5 1.2h50.8c1.6 0 3.15-.45 4.5-1.2z" fill="currentColor"/>
                    </svg>
                    
                    <span class="gdrive-text font-body text-xs uppercase tracking-[0.2em] text-white group-hover:text-blue-400 transition-all font-medium whitespace-nowrap max-w-0 overflow-hidden group-hover:max-w-xs group-hover:ml-1 duration-500">
                        View Works Archive
                    </span>
                </div>
            </div>
        </div>
    </a>
    
    <a href="/gallery" class="gallery-cta-wrapper fixed top-8 right-8 z-50 opacity-0">
        <div class="gallery-cta group relative">
            <div class="particle particle-1 absolute w-2 h-2 rounded-full bg-red-500/60"></div>
            <div class="particle particle-2 absolute w-2 h-2 rounded-full bg-red-500/60"></div>
            <div class="particle particle-3 absolute w-2 h-2 rounded-full bg-red-500/60"></div>
            
            <div class="relative flex items-center gap-3 px-6 py-3 bg-black/60 backdrop-blur-xl rounded-full border border-white/20 group-hover:border-red-500 group-hover:bg-red-500/10 transition-all duration-500 group-hover:scale-105">
                <div class="absolute inset-0 rounded-full bg-red-500/30 scale-0 group-hover:scale-150 opacity-0 group-hover:opacity-100 blur-md transition-all duration-700"></div>
                
                <div class="relative flex items-center gap-3">
                    <div class="w-6 h-6 relative">
                        <div class="absolute inset-0 bg-gradient-to-br from-red-500 to-red-600 rounded-full animate-pulse"></div>
                        <div class="absolute inset-0.5 bg-black rounded-full flex items-center justify-center">
                            <div class="w-2 h-2 bg-red-500 rounded-full group-hover:animate-ping"></div>
                        </div>
                    </div>
                    
                    <span class="cta-text font-body text-xs uppercase tracking-[0.2em] text-white group-hover:text-red-400 transition-colors font-medium">
                        View My Works
                    </span>
                    
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-white/60 group-hover:text-red-500 group-hover:translate-x-1 transition-all">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </div>
            </div>
        </div>
    </a>
    
    <div class="absolute bottom-12 left-0 right-0 text-center opacity-0 scroll-hint">
        <p class="font-body text-sm uppercase tracking-widest text-neutral-500">Scroll to Begin</p>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    
    function splitText(element) {
        const text = element.textContent || '';
        const chars = text.split('');
        element.innerHTML = chars.map((char) => 
            `<span class="char" style="display:inline-block; opacity:0;">${char === ' ' ? '&nbsp;' : char}</span>`
        ).join('');
    }

    document.querySelectorAll('.manifesto-sub .word, .manifesto-sub-alt .word-alt').forEach(word => {
        splitText(word);
    });

    const tl = gsap.timeline({ defaults: { ease: "power4.out" } });

    tl.to(".personal-brand", {
        opacity: 1,
        y: 0,
        duration: 1.2,
        delay: 0.2
    })
    .to(".manifesto-line", {
        opacity: 1,
        duration: 0.01,
        stagger: 0
    })
    .to(".manifesto-line", {
        y: 0,
        duration: 1.5,
        stagger: 0.3,
        delay: 0.3
    })
    .to(".manifesto-sub .char", {
        opacity: 1,
        y: 0,
        rotation: 0,
        duration: 0.6,
        stagger: 0.02,
        ease: "back.out(1.7)"
    }, "-=0.8")
    .from(".manifesto-kicker, .hero-support, .hero-support-alt", {
        opacity: 0,
        y: 14,
        duration: 0.8,
        stagger: 0.08
    }, "-=1")
    .from(".manifesto-set-1 a", {
        opacity: 0,
        y: 12,
        duration: 0.7,
        stagger: 0.08
    }, "-=0.6")
    .to(".scroll-hint", {
        opacity: 1,
        duration: 1,
        y: 10,
        repeat: -1,
        yoyo: true,
        ease: "power1.inOut"
    })
    .to(".gallery-cta-wrapper", {
        opacity: 1,
        y: -10,
        duration: 1.5,
        ease: "power3.out"
    }, "-=1")
    .to(".gdrive-cta-wrapper", {
        opacity: 1,
        y: -10,
        duration: 1.5,
        ease: "power3.out"
    }, "-=1.3");
    
    const ctaButton = document.querySelector('.gallery-cta');
    if (ctaButton) {
        ctaButton.addEventListener('mousemove', (e) => {
            const rect = ctaButton.getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;
            
            gsap.to(ctaButton, {
                x: x * 0.3,
                y: y * 0.3,
                duration: 0.5,
                ease: 'power2.out'
            });
        });
        
        ctaButton.addEventListener('mouseleave', () => {
            gsap.to(ctaButton, {
                x: 0,
                y: 0,
                duration: 0.8,
                ease: 'elastic.out(1, 0.5)'
            });
        });
    }
    
    const gdriveButton = document.querySelector('.gdrive-cta');
    if (gdriveButton) {
        gdriveButton.addEventListener('mousemove', (e) => {
            const rect = gdriveButton.getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;
            
            gsap.to(gdriveButton, {
                x: x * 0.3,
                y: y * 0.3,
                duration: 0.5,
                ease: 'power2.out'
            });
        });
        
        gdriveButton.addEventListener('mouseleave', () => {
            gsap.to(gdriveButton, {
                x: 0,
                y: 0,
                duration: 0.8,
                ease: 'elastic.out(1, 0.5)'
            });
        });
    }
    
    function glitchEffect(element) {
        const glitchTl = gsap.timeline();
        
        glitchTl.to(element, {
            textShadow: '5px 0 0 #ff0000, -5px 0 0 #00ffff',
            skewX: 10,
            duration: 0.05,
        })
        .to(element, {
            textShadow: '-5px 0 0 #ff0000, 5px 0 0 #00ffff',
            skewX: -10,
            duration: 0.05,
        })
        .to(element, {
            textShadow: '3px 3px 0 #ff0000, -3px -3px 0 #00ffff',
            skewX: 5,
            duration: 0.05,
        })
        .to(element, {
            textShadow: 'none',
            skewX: 0,
            duration: 0.1,
        });
        
        return glitchTl;
    }
    
    let currentSet = 1;
    let textSwitchInterval = null;
    
    function switchText() {
        const set1 = document.querySelector('.manifesto-set-1');
        const set2 = document.querySelector('.manifesto-set-2');
        
        if (currentSet === 1) {
            const glitchElements1 = set1?.querySelectorAll('.glitch-text');
            glitchElements1?.forEach(el => glitchEffect(el));
            
            gsap.to(set1, {
                opacity: 0,
                scale: 0.95,
                filter: 'blur(5px)',
                duration: 0.5,
                ease: "power2.in"
            });
            
            gsap.set(".manifesto-line-alt", { opacity: 1, y: 0 });
            
            gsap.to(set2, {
                opacity: 1,
                scale: 1,
                filter: 'blur(0px)',
                duration: 0.5,
                delay: 0.3,
                ease: "power2.out",
                onStart: () => {
                    const glitchElements2 = set2?.querySelectorAll('.glitch-text');
                    glitchElements2?.forEach(el => glitchEffect(el));
                }
            });
            
            gsap.fromTo(".manifesto-sub-alt .char", 
                { opacity: 0, y: 20 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.6,
                    stagger: 0.02,
                    delay: 0.5,
                    ease: "back.out(1.7)"
                }
            );
            
            currentSet = 2;
        } else {
            const glitchElements2 = set2?.querySelectorAll('.glitch-text');
            glitchElements2?.forEach(el => glitchEffect(el));
            
            gsap.to(set2, {
                opacity: 0,
                scale: 0.95,
                filter: 'blur(5px)',
                duration: 0.5,
                ease: "power2.in"
            });
            
            gsap.set(".manifesto-line", { opacity: 1, y: 0 });
            
            gsap.to(set1, {
                opacity: 1,
                scale: 1,
                filter: 'blur(0px)',
                duration: 0.5,
                delay: 0.3,
                ease: "power2.out",
                onStart: () => {
                    const glitchElements1 = set1?.querySelectorAll('.glitch-text');
                    glitchElements1?.forEach(el => glitchEffect(el));
                }
            });
            
            gsap.fromTo(".manifesto-sub .char", 
                { opacity: 0, y: 20 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.6,
                    stagger: 0.02,
                    delay: 0.5,
                    ease: "back.out(1.7)"
                }
            );
            
            currentSet = 1;
        }
    }
    
    function startTextSwitcher() {
        if (textSwitchInterval === null) {
            textSwitchInterval = setInterval(switchText, 10000);
        }
    }
    
    function stopTextSwitcher() {
        if (textSwitchInterval !== null) {
            clearInterval(textSwitchInterval);
            textSwitchInterval = null;
        }
    }
    
    function handleVisibilityChange() {
        if (document.hidden) {
            stopTextSwitcher();
            gsap.globalTimeline.pause();
        } else {
            gsap.globalTimeline.resume();
            
            const set1 = document.querySelector('.manifesto-set-1');
            const set2 = document.querySelector('.manifesto-set-2');
            
            gsap.set(set1, { opacity: 1, scale: 1, filter: 'blur(0px)' });
            gsap.set(set2, { opacity: 0, scale: 0.95, filter: 'blur(5px)' });
            gsap.set(".manifesto-line", { opacity: 1, y: 0 });
            gsap.set(".manifesto-sub .char", { opacity: 1, y: 0, rotation: 0 });
            
            currentSet = 1;
            startTextSwitcher();
        }
    }
    
    document.addEventListener('visibilitychange', handleVisibilityChange);
    startTextSwitcher();
    
    const glitchElements = document.querySelectorAll('.glitch-text');
    glitchElements.forEach(el => {
        el.addEventListener('mouseenter', () => {
            glitchEffect(el);
        });
    });
    
    const container = document.getElementById('manifesto');
    if (container) {
        container.addEventListener('mousemove', (e) => {
            const { clientX, clientY } = e;
            const xPos = (clientX / window.innerWidth - 0.5) * 30;
            const yPos = (clientY / window.innerHeight - 0.5) * 30;
            
            gsap.to('.manifesto-content', {
                x: xPos,
                y: yPos,
                duration: 1,
                ease: 'power2.out'
            });
        });
    }
</script>

<style>
    .manifesto-line,
    .manifesto-line-alt {
        opacity: 0;
        transform: translateY(50px);
        will-change: transform, opacity;
    }
    
    .char {
        transform: translateY(20px) rotate(-5deg);
        will-change: transform, opacity;
    }
    
    .glitch-text {
        position: relative;
        display: inline-block;
        transition: all 0.1s;
    }
    
    .manifesto-bg {
        background: radial-gradient(circle at 50% 50%, rgba(255, 51, 51, 0.05) 0%, transparent 70%);
    }
    
    .manifesto-set-2 {
        pointer-events: none;
    }
    
    .gallery-cta-wrapper,
    .gdrive-cta-wrapper {
        animation: float 3s ease-in-out infinite;
        transition: opacity 0.6s ease, transform 0.6s ease;
    }
    
    @keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
    }
    
    .gallery-cta,
    .gdrive-cta {
        cursor: pointer;
        position: relative;
    }
    
    .gdrive-text {
        transition: max-width 0.5s cubic-bezier(0.4, 0, 0.2, 1), 
                    margin-left 0.5s cubic-bezier(0.4, 0, 0.2, 1),
                    opacity 0.3s ease;
        opacity: 0;
    }
    
    .gdrive-cta:hover .gdrive-text {
        opacity: 1;
    }
    
    .particle {
        animation: particle-float 4s ease-in-out infinite;
        opacity: 0;
    }
    
    .particle-1 {
        top: -15px;
        right: -10px;
        animation-delay: 0s;
    }
    
    .particle-2 {
        top: -20px;
        right: 20px;
        animation-delay: 1.5s;
    }
    
    .particle-3 {
        top: -10px;
        right: 40px;
        animation-delay: 3s;
    }
    
    @keyframes particle-float {
        0% {
            opacity: 0;
            transform: translateY(0) scale(1);
        }
        20% {
            opacity: 1;
        }
        100% {
            opacity: 0;
            transform: translateY(-30px) scale(0);
        }
    }
    
    .gallery-cta:hover .particle,
    .gdrive-cta:hover .particle {
        animation-duration: 2s;
    }
</style>
