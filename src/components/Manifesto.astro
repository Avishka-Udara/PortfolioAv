---
---

<section id="manifesto" class="relative min-h-screen flex flex-col justify-center items-center px-4 overflow-hidden">
    
    <!-- Background Content (Video/Image Placeholder) -->
    <div class="manifesto-bg absolute inset-0 -z-10"></div>

    <!-- Personal Branding -->
    <div class="absolute top-12 left-0 right-0 text-center z-20 opacity-0 personal-brand">
        <p class="font-body text-xs md:text-sm uppercase tracking-[0.3em] text-neutral-400 font-light">
            Avishka Udara — Motion Designer & Visual Storyteller
        </p>
    </div>

    <!-- Content - Set 1 (Default) -->
    <div class="manifesto-content manifesto-set-1 relative z-10 text-center mix-blend-difference">
        <h1 class="manifesto-line font-display text-[10vw] md:text-[9vw] font-black leading-[0.85] tracking-tighter uppercase text-white">
            <span class="glitch-text" data-text="I Don't Design">I Don't Design</span>
        </h1>
        <h1 class="manifesto-line font-display text-[10vw] md:text-[9vw] font-black leading-[0.85] tracking-tighter uppercase text-white">
            <span class="glitch-text" data-text="Frames">Frames</span>
        </h1>
        <div class="h-9 md:h-24"></div> <!-- Spacer -->
        <h2 class="manifesto-sub font-display text-[6vw] md:text-[5vw] font-bold leading-[0.9] tracking-tight uppercase text-neutral-400">
            <span class="word">I</span> <span class="word">Design</span> <span class="word">Moments</span> <span class="word">That</span> <span class="word">Move</span>
        </h2>
    </div>
    
    <!-- Content - Set 2 (Alternate) -->
    <div class="manifesto-content manifesto-set-2 absolute inset-0 flex flex-col justify-center items-center z-10 text-center mix-blend-difference opacity-0">
        <h1 class="manifesto-line-alt font-display text-[10vw] md:text-[9vw] font-black leading-[0.85] tracking-tighter uppercase text-white">
            <span class="glitch-text" data-text="I Don't Create">I Don't Create</span>
        </h1>
        <h1 class="manifesto-line-alt font-display text-[10vw] md:text-[9vw] font-black leading-[0.85] tracking-tighter uppercase text-white">
            <span class="glitch-text" data-text="Visuals">Visuals</span>
        </h1>
        <div class="h-9 md:h-24"></div> <!-- Spacer -->
        <h2 class="manifesto-sub-alt font-display text-[6vw] md:text-[5vw] font-bold leading-[0.9] tracking-tight uppercase text-neutral-400">
            <span class="word-alt">I</span> <span class="word-alt">Shape</span> <span class="word-alt">Perception</span>
        </h2>
    </div>
    
    <!-- Gallery CTA Button - Fixed Top Right -->
    <a href="/gallery" class="gallery-cta-wrapper fixed top-8 right-8 z-50 opacity-0">
        <div class="gallery-cta group relative">
            <!-- Animated particles -->
            <div class="particle particle-1 absolute w-2 h-2 rounded-full bg-red-500/60"></div>
            <div class="particle particle-2 absolute w-2 h-2 rounded-full bg-red-500/60"></div>
            <div class="particle particle-3 absolute w-2 h-2 rounded-full bg-red-500/60"></div>
            
            <!-- Main button -->
            <div class="relative flex items-center gap-3 px-6 py-3 bg-black/60 backdrop-blur-xl rounded-full border border-white/20 group-hover:border-red-500 group-hover:bg-red-500/10 transition-all duration-500 group-hover:scale-105">
                <!-- Pulse ring on hover -->
                <div class="absolute inset-0 rounded-full bg-red-500/30 scale-0 group-hover:scale-150 opacity-0 group-hover:opacity-100 blur-md transition-all duration-700"></div>
                
                <div class="relative flex items-center gap-3">
                    <!-- Icon -->
                    <div class="w-6 h-6 relative">
                        <div class="absolute inset-0 bg-gradient-to-br from-red-500 to-red-600 rounded-full animate-pulse"></div>
                        <div class="absolute inset-0.5 bg-black rounded-full flex items-center justify-center">
                            <div class="w-2 h-2 bg-red-500 rounded-full group-hover:animate-ping"></div>
                        </div>
                    </div>
                    
                    <!-- Text -->
                    <span class="cta-text font-body text-xs uppercase tracking-[0.2em] text-white group-hover:text-red-400 transition-colors font-medium">
                        View My Works
                    </span>
                    
                    <!-- Arrow -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-white/60 group-hover:text-red-500 group-hover:translate-x-1 transition-all">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </div>
            </div>
        </div>
    </a>
    
    <div class="absolute bottom-12 left-0 right-0 text-center opacity-0 scroll-hint">
        <p class="font-body text-sm uppercase tracking-widest text-neutral-500">↓ Scroll to Begin</p>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    
    // Split text into characters
    function splitText(element: Element) {
        const text = element.textContent || '';
        const chars = text.split('');
        element.innerHTML = chars.map((char, i) => 
            `<span class="char" style="display:inline-block; opacity:0;">${char === ' ' ? '&nbsp;' : char}</span>`
        ).join('');
    }

    // Split all words in subtitle (both sets)
    document.querySelectorAll('.manifesto-sub .word, .manifesto-sub-alt .word-alt').forEach(word => {
        splitText(word);
    });

    const tl = gsap.timeline({ defaults: { ease: "power4.out" } });

    // Personal brand fade in first
    tl.to(".personal-brand", {
        opacity: 1,
        y: 0,
        duration: 1.2,
        delay: 0.2
    })
    // Main lines with stagger (Set 1)
    .to(".manifesto-line", {
        opacity: 1,
        duration: 0.01,
        stagger: 0
    })
    .to(".manifesto-line", {
        y: 0,
        duration: 1.5,
        stagger: 0.3,
        delay: 0.3
    })
    // Character animation for subtitle
    .to(".manifesto-sub .char", {
        opacity: 1,
        y: 0,
        rotation: 0,
        duration: 0.6,
        stagger: 0.02,
        ease: "back.out(1.7)"
    }, "-=0.8")
    .to(".scroll-hint", {
        opacity: 1,
        duration: 1,
        y: 10,
        repeat: -1,
        yoyo: true,
        ease: "power1.inOut"
    })
    // Gallery CTA fade in
    .to(".gallery-cta-wrapper", {
        opacity: 1,
        y: -10,
        duration: 1.5,
        ease: "power3.out"
    }, "-=1");
    
    // Magnetic hover effect for gallery button
    const ctaButton = document.querySelector('.gallery-cta');
    if (ctaButton) {
        ctaButton.addEventListener('mousemove', (e) => {
            const rect = ctaButton.getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;
            
            gsap.to(ctaButton, {
                x: x * 0.3,
                y: y * 0.3,
                duration: 0.5,
                ease: 'power2.out'
            });
        });
        
        ctaButton.addEventListener('mouseleave', () => {
            gsap.to(ctaButton, {
                x: 0,
                y: 0,
                duration: 0.8,
                ease: 'elastic.out(1, 0.5)'
            });
        });
        
        // Glitch on click
        ctaButton.addEventListener('click', (e) => {
            const text = ctaButton.querySelector('.cta-text');
            if (text) {
                gsap.timeline()
                    .to(text, {
                        textShadow: '3px 0 0 #ff0000, -3px 0 0 #00ffff',
                        duration: 0.05,
                        repeat: 2,
                        yoyo: true
                    })
                    .to(text, {
                        textShadow: 'none',
                        duration: 0.1
                    });
            }
        });
    }
    
    // Glitch effect function
    function glitchEffect(element: Element) {
        const glitchTl = gsap.timeline();
        
        glitchTl.to(element, {
            textShadow: '5px 0 0 #ff0000, -5px 0 0 #00ffff',
            skewX: 10,
            duration: 0.05,
        })
        .to(element, {
            textShadow: '-5px 0 0 #ff0000, 5px 0 0 #00ffff',
            skewX: -10,
            duration: 0.05,
        })
        .to(element, {
            textShadow: '3px 3px 0 #ff0000, -3px -3px 0 #00ffff',
            skewX: 5,
            duration: 0.05,
        })
        .to(element, {
            textShadow: 'none',
            skewX: 0,
            duration: 0.1,
        });
        
        return glitchTl;
    }
    
    // Alternating text switcher
    let currentSet = 1;
    let textSwitchInterval: number | null = null;
    
    function switchText() {
        const set1 = document.querySelector('.manifesto-set-1');
        const set2 = document.querySelector('.manifesto-set-2');
        
        if (currentSet === 1) {
            // Glitch out Set 1
            const glitchElements1 = set1?.querySelectorAll('.glitch-text');
            glitchElements1?.forEach(el => glitchEffect(el));
            
            // Fade out Set 1, Fade in Set 2
            gsap.to(set1, {
                opacity: 0,
                scale: 0.95,
                filter: 'blur(5px)',
                duration: 0.5,
                ease: "power2.in"
            });
            
            // Show Set 2 main lines first
            gsap.set(".manifesto-line-alt", { opacity: 1, y: 0 });
            
            gsap.to(set2, {
                opacity: 1,
                scale: 1,
                filter: 'blur(0px)',
                duration: 0.5,
                delay: 0.3,
                ease: "power2.out",
                onStart: () => {
                    // Glitch in Set 2
                    const glitchElements2 = set2?.querySelectorAll('.glitch-text');
                    glitchElements2?.forEach(el => glitchEffect(el));
                }
            });
            
            // Animate characters in Set 2 subtitle
            gsap.fromTo(".manifesto-sub-alt .char", 
                { opacity: 0, y: 20 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.6,
                    stagger: 0.02,
                    delay: 0.5,
                    ease: "back.out(1.7)"
                }
            );
            
            currentSet = 2;
        } else {
            // Glitch out Set 2
            const glitchElements2 = set2?.querySelectorAll('.glitch-text');
            glitchElements2?.forEach(el => glitchEffect(el));
            
            // Fade out Set 2, Fade in Set 1
            gsap.to(set2, {
                opacity: 0,
                scale: 0.95,
                filter: 'blur(5px)',
                duration: 0.5,
                ease: "power2.in"
            });
            
            // Show Set 1 main lines
            gsap.set(".manifesto-line", { opacity: 1, y: 0 });
            
            gsap.to(set1, {
                opacity: 1,
                scale: 1,
                filter: 'blur(0px)',
                duration: 0.5,
                delay: 0.3,
                ease: "power2.out",
                onStart: () => {
                    // Glitch in Set 1
                    const glitchElements1 = set1?.querySelectorAll('.glitch-text');
                    glitchElements1?.forEach(el => glitchEffect(el));
                }
            });
            
            // Animate characters in Set 1 subtitle
            gsap.fromTo(".manifesto-sub .char", 
                { opacity: 0, y: 20 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.6,
                    stagger: 0.02,
                    delay: 0.5,
                    ease: "back.out(1.7)"
                }
            );
            
            currentSet = 1;
        }
    }
    
    // Function to start the text switching interval
    function startTextSwitcher() {
        if (textSwitchInterval === null) {
            textSwitchInterval = setInterval(switchText, 10000);
        }
    }
    
    // Function to stop the text switching interval
    function stopTextSwitcher() {
        if (textSwitchInterval !== null) {
            clearInterval(textSwitchInterval);
            textSwitchInterval = null;
        }
    }
    
    // Handle page visibility changes
    function handleVisibilityChange() {
        if (document.hidden) {
            // Page is hidden - pause all animations
            stopTextSwitcher();
            gsap.globalTimeline.pause();
        } else {
            // Page is visible - resume animations and reset state
            gsap.globalTimeline.resume();
            
            // Reset to a clean state to avoid glitches
            const set1 = document.querySelector('.manifesto-set-1');
            const set2 = document.querySelector('.manifesto-set-2');
            
            // Force back to set 1 with proper positioning
            gsap.set(set1, { opacity: 1, scale: 1, filter: 'blur(0px)' });
            gsap.set(set2, { opacity: 0, scale: 0.95, filter: 'blur(5px)' });
            gsap.set(".manifesto-line", { opacity: 1, y: 0 });
            gsap.set(".manifesto-sub .char", { opacity: 1, y: 0, rotation: 0 });
            
            currentSet = 1;
            
            // Restart the interval
            startTextSwitcher();
        }
    }
    
    // Listen for visibility changes
    document.addEventListener('visibilitychange', handleVisibilityChange);
    
    // Start alternating after initial animation (10 seconds interval)
    startTextSwitcher();
    
    // Glitch effect on hover
    const glitchElements = document.querySelectorAll('.glitch-text');
    glitchElements.forEach(el => {
        el.addEventListener('mouseenter', () => {
            glitchEffect(el);
        });
    });
    
    // Mouse movement parallax effect
    const container = document.getElementById('manifesto');
    if (container) {
        container.addEventListener('mousemove', (e) => {
            const { clientX, clientY } = e;
            const xPos = (clientX / window.innerWidth - 0.5) * 30;
            const yPos = (clientY / window.innerHeight - 0.5) * 30;
            
            gsap.to('.manifesto-content', {
                x: xPos,
                y: yPos,
                duration: 1,
                ease: 'power2.out'
            });
        });
    }
</script>

<style>
    .manifesto-line,
    .manifesto-line-alt {
        opacity: 0;
        transform: translateY(50px);
        will-change: transform, opacity;
    }
    
    .char {
        transform: translateY(20px) rotate(-5deg);
        will-change: transform, opacity;
    }
    
    .glitch-text {
        position: relative;
        display: inline-block;
        transition: all 0.1s;
    }
    
    .manifesto-bg {
        background: radial-gradient(circle at 50% 50%, rgba(255, 51, 51, 0.05) 0%, transparent 70%);
    }
    
    .manifesto-set-2 {
        pointer-events: none;
    }
    
    .manifesto-set-1.active,
    .manifesto-set-2.active {
        pointer-events: auto;
    }
    
    /* Gallery CTA Button - Scroll-triggered Floating */
    .gallery-cta-wrapper {
        animation: float 3s ease-in-out infinite;
        transition: opacity 0.6s ease, transform 0.6s ease;
    }
    
    @keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
    }
    
    .gallery-cta {
        cursor: pointer;
        position: relative;
    }
    
    /* Floating particles */
    .particle {
        animation: particle-float 4s ease-in-out infinite;
        opacity: 0;
    }
    
    .particle-1 {
        top: -15px;
        right: -10px;
        animation-delay: 0s;
    }
    
    .particle-2 {
        top: -20px;
        right: 20px;
        animation-delay: 1.5s;
    }
    
    .particle-3 {
        top: -10px;
        right: 40px;
        animation-delay: 3s;
    }
    
    @keyframes particle-float {
        0% {
            opacity: 0;
            transform: translateY(0) scale(1);
        }
        20% {
            opacity: 1;
        }
        100% {
            opacity: 0;
            transform: translateY(-30px) scale(0);
        }
    }
    
    .gallery-cta:hover .particle {
        animation-duration: 2s;
    }
</style>
