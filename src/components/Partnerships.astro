---
import { toEncodedAssetPath } from '../data/portfolioAssets';

interface Partner {
  name: string;
  src: string;
  sector: string;
  summary: string;
}

interface Props {
  partners: Partner[];
}

const { partners } = Astro.props;
const featuredPartners = partners.slice(0, 3);
---

<section id="partnerships" class="relative overflow-hidden border-t border-white/8 bg-[#040404] px-4 py-24 md:px-8 md:py-32">
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute left-[-8%] top-10 h-72 w-72 rounded-full bg-red-500/12 blur-[110px]"></div>
    <div class="absolute right-[-8%] top-1/3 h-80 w-80 rounded-full bg-cyan-500/10 blur-[120px]"></div>
    <div class="absolute bottom-[-10%] left-1/3 h-64 w-64 rounded-full bg-emerald-500/10 blur-[120px]"></div>
  </div>

  <div class="partnership-grid relative mx-auto grid max-w-7xl gap-10 lg:grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)] lg:items-start">
    <div class="lg:sticky lg:top-28">
      <p class="text-xs uppercase tracking-[0.38em] text-white/40">Long-Term Partnerships</p>
      <h2 class="mt-5 font-display text-5xl leading-[0.92] text-white md:text-7xl">
        Trusted by brands and NGOs I keep building with over time.
      </h2>
      <p class="mt-6 max-w-xl text-base leading-7 text-white/68 md:text-lg">
        These are the teams I have supported across branding, campaign design, motion, healthcare visuals, product ecosystems, and digital growth. The section is designed as a partner wall, not a plain sponsor list.
      </p>

      <div class="mt-10 grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
        {featuredPartners.map((partner, index) => (
          <article class="rounded-[1.75rem] border border-white/10 bg-white/[0.05] p-5 backdrop-blur-xl">
            <p class="text-[0.68rem] uppercase tracking-[0.32em] text-white/38">0{index + 1}</p>
            <h3 class="mt-3 font-display text-2xl text-white">{partner.name}</h3>
            <p class="mt-2 text-sm uppercase tracking-[0.24em] text-red-400/80">{partner.sector}</p>
          </article>
        ))}
      </div>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {partners.map((partner, index) => (
        <article
          class={`partner-card group relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.04] p-4 shadow-[0_18px_60px_rgba(0,0,0,0.28)] backdrop-blur-xl transition-all duration-500 hover:-translate-y-2 hover:border-white/20 ${index % 3 === 0 ? 'md:translate-y-8' : ''}`}
        >
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,0.08),transparent_42%)] opacity-70"></div>
          <div class="absolute inset-x-6 bottom-0 h-24 rounded-full bg-gradient-to-r from-red-500/0 via-red-500/12 to-cyan-500/0 blur-3xl transition-opacity duration-500 group-hover:opacity-100 opacity-0"></div>

          <div class="relative rounded-[1.5rem] border border-white/8 bg-black/55 px-6 py-7 min-h-[12rem] flex items-center justify-center overflow-hidden">
            <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(255,255,255,0.08),transparent_42%)]"></div>
            <img
              src={toEncodedAssetPath(partner.src)}
              alt={`${partner.name} logo`}
              loading="lazy"
              class="max-h-24 w-auto max-w-full object-contain grayscale brightness-125 opacity-80 transition-all duration-500 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105"
            />
          </div>

          <div class="relative px-2 pb-2 pt-5">
            <div class="flex items-center justify-between gap-4">
              <h3 class="font-display text-2xl leading-tight text-white">{partner.name}</h3>
              <span class="shrink-0 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1 text-[0.62rem] uppercase tracking-[0.3em] text-white/45">
                Partner
              </span>
            </div>
            <p class="mt-3 text-xs uppercase tracking-[0.28em] text-red-400/80">{partner.sector}</p>
            <p class="mt-4 text-sm leading-7 text-white/65">{partner.summary}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .partnership-grid {
    background-image:
      linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-position: center;
    background-size: 120px 120px;
  }

  .partner-card {
    animation: partner-rise 0.7s ease both;
  }

  @keyframes partner-rise {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 767px) {
    .partner-card {
      transform: none !important;
    }
  }
</style>
