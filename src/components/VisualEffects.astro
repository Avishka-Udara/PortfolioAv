---
---

<!-- Custom Cursor (Optimized) -->
<div id="cursor-dot" class="cursor-dot"></div>
<div id="cursor-ring" class="cursor-ring"></div>

<!-- Film Grain Overlay -->
<div class="film-grain"></div>

<script>
    // Optimized Custom Cursor
    const dot = document.getElementById('cursor-dot');
    const ring = document.getElementById('cursor-ring');
    
    let mouseX = 0, mouseY = 0;
    let ringX = 0, ringY = 0;
    let isHovering = false;
    
    // Update cursor position instantly
    document.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
        
        // Dot follows immediately (hardware accelerated)
        if (dot) {
            dot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0)`;
        }
    });
    
    // Smooth ring animation with optimized RAF
    function animateRing() {
        const dx = mouseX - ringX;
        const dy = mouseY - ringY;
        
        ringX += dx * 0.15; // Faster response
        ringY += dy * 0.15;
        
        if (ring) {
            ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0)`;
        }
        
        requestAnimationFrame(animateRing);
    }
    
    animateRing();
    
    // Hover states (optimized)
    const addHoverListeners = () => {
        const interactive = document.querySelectorAll('a, button, input, textarea, [role="button"]');
        
        interactive.forEach(el => {
            el.addEventListener('mouseenter', () => {
                isHovering = true;
                dot?.classList.add('hover');
                ring?.classList.add('hover');
            });
            
            el.addEventListener('mouseleave', () => {
                isHovering = false;
                dot?.classList.remove('hover');
                ring?.classList.remove('hover');
            });
        });
    };
    
    // Initialize
    addHoverListeners();
    
    // Re-initialize for dynamically added elements
    const observer = new MutationObserver(addHoverListeners);
    observer.observe(document.body, { childList: true, subtree: true });
    
    // Hide default cursor
    document.body.style.cursor = 'none';
    document.querySelectorAll('a, button').forEach(el => {
        (el as HTMLElement).style.cursor = 'none';
    });
</script>

<style>
    /* Hardware-accelerated cursor */
    .cursor-dot,
    .cursor-ring {
        position: fixed;
        top: 0;
        left: 0;
        pointer-events: none;
        z-index: 9999;
        transform: translate3d(-50%, -50%, 0);
        will-change: transform;
    }
    
    /* Core dot - sleek and minimal */
    .cursor-dot {
        width: 8px;
        height: 8px;
        background: #fff;
        border-radius: 50%;
        mix-blend-mode: difference;
        transition: width 0.2s ease, height 0.2s ease, opacity 0.2s ease;
    }
    
    /* Ring - professional outline */
    .cursor-ring {
        width: 32px;
        height: 32px;
        border: 1.5px solid rgba(255, 255, 255, 0.5);
        border-radius: 50%;
        mix-blend-mode: difference;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    
    /* Hover state - expand with accent */
    .cursor-dot.hover {
        width: 6px;
        height: 6px;
        background: #ff3333;
    }
    
    .cursor-ring.hover {
        width: 48px;
        height: 48px;
        border-color: rgba(255, 51, 51, 0.8);
        border-width: 2px;
    }
    
    /* Film Grain - same as before */
    .film-grain {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        z-index: 9998;
        opacity: 0.03;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        animation: grain 8s steps(10) infinite;
    }
    
    @keyframes grain {
        0%, 100% { transform: translate(0, 0); }
        10% { transform: translate(-5%, -10%); }
        20% { transform: translate(-15%, 5%); }
        30% { transform: translate(7%, -25%); }
        40% { transform: translate(-5%, 25%); }
        50% { transform: translate(-15%, 10%); }
        60% { transform: translate(15%, 0%); }
        70% { transform: translate(0%, 15%); }
        80% { transform: translate(3%, 35%); }
        90% { transform: translate(-10%, 10%); }
    }
</style>
