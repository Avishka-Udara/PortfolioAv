---
interface Props {
    actNumber: string; // e.g., "ACT I"
    title: string;
    subtitle: string;
    description: string;
    align?: "left" | "right" | "center";
    bgColor?: string;
}

const { actNumber, title, subtitle, description, align = "left", bgColor = "from-purple-900/30 to-black" } = Astro.props;

const alignClass = align === "center" ? "items-center text-center" : 
                   align === "right" ? "items-end text-right" : "items-start text-left";
---

<section class="act-section relative min-h-screen flex flex-col justify-center px-8 md:px-16 overflow-hidden border-t border-white/5 bg-black">
    
    <!-- Visual Layer (Base) -->
    <div class="act-visual absolute inset-0 z-0 overflow-hidden">
        <slot name="visual" />
    </div>

    <!-- Gradient Overlay (Middle) -->
    <div class={`act-bg absolute inset-0 z-0 bg-gradient-to-br ${bgColor} opacity-70 pointer-events-none`}></div>
    <div class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_50%_50%,rgba(255,255,255,0.03)_0%,transparent_50%)] pointer-events-none"></div>

    <!-- Decorative elements -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-gradient-radial from-red-500/10 to-transparent blur-3xl z-0 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-gradient-radial from-blue-500/10 to-transparent blur-3xl z-0 pointer-events-none"></div>

    <!-- Content (Top) -->
    <div class={`act-content relative z-10 flex flex-col max-w-6xl w-full mx-auto ${alignClass}`}>
        <div class="act-number-wrapper mb-4 overflow-hidden relative inline-block">
            <!-- Particles -->
            <div class="particle particle-1 absolute w-1.5 h-1.5 rounded-full bg-red-500/60"></div>
            <div class="particle particle-2 absolute w-1.5 h-1.5 rounded-full bg-red-500/60"></div>
            <div class="particle particle-3 absolute w-1.5 h-1.5 rounded-full bg-red-500/60"></div>
            
            <span class="act-number font-body text-sm md:text-base tracking-[0.4em] text-red-500 font-bold block">{actNumber}</span>
        </div>
        
        <div class="act-title-wrapper overflow-hidden mb-6">
            <h2 class="act-title font-display text-6xl md:text-8xl lg:text-9xl font-black leading-[0.9] tracking-tighter text-white">
                {title}
            </h2>
        </div>
        
        <div class="overflow-hidden mb-8">
            <h3 class="act-subtitle font-display text-xl md:text-2xl font-light text-neutral-300 italic">
                {subtitle}
            </h3>
        </div>
        
        <div class="overflow-hidden max-w-lg">
            <p class="act-desc font-body text-base md:text-lg text-neutral-400 leading-relaxed">
                {description}
            </p>
        </div>
        
        <div class="mt-5">
            <slot />
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    
    gsap.registerPlugin(ScrollTrigger);

    const acts = document.querySelectorAll('.act-section');

    acts.forEach((act) => {
        const number = act.querySelector('.act-number');
        const title = act.querySelector('.act-title');
        const subtitle = act.querySelector('.act-subtitle');
        const desc = act.querySelector('.act-desc');
        const button = act.querySelector('.act-button');
        const visual = act.querySelector('.act-visual');
        const bg = act.querySelector('.act-bg');

        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: act,
                start: "top 70%",
                toggleActions: "play none none reverse"
            }
        });

        // Stagger entrance
        tl.from(number, { 
            yPercent: 100, 
            opacity: 0, 
            duration: 0.8, 
            ease: "power3.out" 
        })
        .from(title, { 
            yPercent: 100, 
            opacity: 0, 
            duration: 1.2, 
            ease: "power4.out" 
        }, "-=0.6")
        .from(subtitle, { 
            yPercent: 100, 
            opacity: 0, 
            duration: 0.8 
        }, "-=0.8")
        .from(desc, { 
            yPercent: 50, 
            opacity: 0, 
            duration: 0.8 
        }, "-=0.6")
        .from(button, { 
            yPercent: 50, 
            opacity: 0, 
            scale: 0.8, 
            duration: 0.8 
        }, "-=0.6");
          
        // Parallax for visual and background
        gsap.to(visual, {
            yPercent: 20,
            ease: "none",
            scrollTrigger: {
                trigger: act,
                start: "top bottom",
                end: "bottom top",
                scrub: 1
            }
        });
        
        gsap.to(bg, {
            scale: 1.2,
            ease: "none",
            scrollTrigger: {
                trigger: act,
                start: "top bottom",
                end: "bottom top",
                scrub: 1
            }
        });
    });
</script>

<style>
    .act-button {
        will-change: transform;
    }
    .act-description {
        opacity: 0;
        transform: translateY(20px);
    }
    
    /* Act number particles */
    .act-number-wrapper {
        position: relative;
        display: inline-block;
    }
    
    .particle {
        animation: particle-float 4s ease-in-out infinite;
        opacity: 0;
        pointer-events: none;
    }
    
    .particle-1 {
        top: -10px;
        left: 0;
        animation-delay: 0s;
    }
    
    .particle-2 {
        top: -15px;
        left: 30%;
        animation-delay: 1.5s;
    }
    
    .particle-3 {
        top: -12px;
        right: 10%;
        animation-delay: 3s;
    }
    
    @keyframes particle-float {
        0% {
            opacity: 0;
            transform: translateY(0) scale(1);
        }
        20% {
            opacity: 1;
        }
        100% {
            opacity: 0;
            transform: translateY(-25px) scale(0);
        }
    }
</style>
