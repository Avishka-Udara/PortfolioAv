---
interface Props {
  items: { src: string; alt: string }[];
  speed?: number; // duration in seconds
  direction?: 'left' | 'right';
}

const { items, speed = 30, direction = 'left' } = Astro.props;
---

<div class="marquee-container relative w-full overflow-hidden py-8 md:py-12 bg-black/40 border-y border-white/5 backdrop-blur-md">
    <div class="marquee-track flex gap-16 items-center" style={`animation-duration: ${speed}s; animation-direction: ${direction === 'right' ? 'reverse' : 'normal'};`}>
        {/* Doubled items for seamless loop */}
        {[...items, ...items].map((item) => (
            <div class="marquee-item flex-shrink-0 grayscale hover:grayscale-0 transition-all duration-500 opacity-80 hover:opacity-100 hover:scale-110">
                <img src={item.src} alt={item.alt} class="h-16 w-auto md:h-20 object-contain brightness-200 contrast-125" />
            </div>
        ))}
    </div>
    
    <!-- Fade edges -->
    <div class="absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-black to-transparent z-10"></div>
    <div class="absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-black to-transparent z-10"></div>
</div>

<style>
    .marquee-track {
        width: max-content;
        animation-name: marquee;
        animation-timing-function: linear;
        animation-iteration-count: infinite;
    }

    @keyframes marquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }
</style>
