---
interface Props {
  src: string;
  poster?: string;
  autoplay?: boolean;
  loop?: boolean;
  muted?: boolean;
  controls?: boolean;
  class?: string;
}

const { src, poster, autoplay = true, loop = true, muted = true, controls = false, class: className } = Astro.props;
---

<div class={`video-container relative overflow-hidden rounded-lg bg-neutral-900 ${className}`}>
  <video
    src={src}
    poster={poster}
    autoplay={autoplay}
    loop={loop}
    muted={muted}
    playsinline
    controls={controls}
    preload="metadata"
    class="video-player w-full h-full object-cover"
    loading="lazy"
  ></video>
  
  <!-- Fallback UI for video errors -->
  <div class="video-player-error hidden absolute inset-0 bg-gradient-to-br from-gray-900 to-black flex flex-col items-center justify-center text-white/60">
    <svg class="w-16 h-16 mb-4 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
    </svg>
    <p class="font-body text-sm uppercase tracking-wider">Video Unavailable</p>
  </div>
  
  {!controls && (
    <div class="absolute inset-0 bg-black/10 pointer-events-none"></div>
  )}
</div>

<script>
  // Lazy play videos only when they are in viewport
  const videos = document.querySelectorAll('video[autoplay].video-player');
  
  // Setup error handlers
  videos.forEach(video => {
    const container = video.closest('.video-container');
    const errorUI = container?.querySelector('.video-player-error');
    
    video.addEventListener('error', (e) => {
      console.warn('Video failed to load:', video.src, e);
      video.classList.add('hidden');
      if (errorUI) {
        errorUI.classList.remove('hidden');
      }
    });
    
    video.addEventListener('loadeddata', () => {
      video.classList.remove('hidden');
      if (errorUI) {
        errorUI.classList.add('hidden');
      }
    });
  });
  
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      const video = entry.target as HTMLVideoElement;
      if (entry.isIntersecting) {
        video.play().catch((e) => {
          // Auto-play might be blocked by browser policy
          console.log('Autoplay blocked:', e);
        });
      } else {
        video.pause();
      }
    });
  }, { threshold: 0.2 });

  videos.forEach(video => observer.observe(video));
</script>
