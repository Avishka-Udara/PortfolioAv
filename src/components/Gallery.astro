---
interface Props {
  images: { src: string; alt?: string }[];
}

const { images } = Astro.props;
---

<div class="masonry-gallery p-4 md:p-8">
    <div class="columns-1 md:columns-2 lg:columns-3 gap-8 space-y-8">
        {images.map((image) => (
            <div class="break-inside-avoid mb-8 group relative overflow-hidden rounded-xl bg-neutral-900 border border-white/5">
                <img 
                    src={image.src} 
                    alt={image.alt || ""} 
                    loading="lazy"
                    class="w-full h-auto object-cover transform transition-transform duration-700 group-hover:scale-105" 
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
                    <p class="text-white font-body text-sm tracking-widest uppercase opacity-0 transform translate-y-4 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500 delay-100">
                        View Detail
                    </p>
                </div>
            </div>
        ))}
    </div>
</div>
