---
import { toEncodedAssetPath } from '../data/portfolioAssets';

interface MediaItem {
    type: 'image' | 'video';
    src: string;
    alt?: string;
    title?: string;
}

interface Props {
    items: MediaItem[];
    interval?: number; // millseconds
    class?: string;
}

const { items, interval = 10000, class: className } = Astro.props;
const carouselId = `carousel-${Math.random().toString(36).slice(2, 10)}`;
---

<div class={`visual-carousel relative w-full h-full overflow-hidden ${className}`} data-carousel-id={carouselId}>
    {items.map((item, index) => (
        <div class={`carousel-item absolute inset-0 transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`} data-index={index} data-src={item.src}>
            {item.type === 'video' ? (
                <div class="w-full h-full relative">
                    <video 
                        src={toEncodedAssetPath(item.src)}
                        loop 
                        muted 
                        playsinline 
                        preload={index === 0 ? 'metadata' : 'none'}
                        class="video-element w-full h-full object-cover"
                    ></video>
                    <!-- Fallback UI for video errors -->
                    <div class="video-error hidden absolute inset-0 bg-gradient-to-br from-gray-900 to-black flex flex-col items-center justify-center text-white/60">
                        <svg class="w-16 h-16 mb-4 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                        <p class="font-body text-sm uppercase tracking-wider">Media Unavailable</p>
                    </div>
                </div>
            ) : (
                <div class="w-full h-full relative">
                    <img 
                        src={toEncodedAssetPath(item.src)} 
                        alt={item.alt || ""} 
                        loading={index === 0 ? 'eager' : 'lazy'}
                        decoding="async"
                        class="image-element w-full h-full object-cover"
                    />
                    <!-- Fallback UI for image errors -->
                    <div class="image-error hidden absolute inset-0 bg-gradient-to-br from-gray-900 to-black flex flex-col items-center justify-center text-white/60">
                        <svg class="w-16 h-16 mb-4 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        <p class="font-body text-sm uppercase tracking-wider">Image Unavailable</p>
                    </div>
                </div>
            )}
            <div class="absolute inset-0 bg-black/80"></div>
        </div>
    ))}
    
    <!-- Progress Indicator (Optional) -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 flex space-x-2 z-20">
        {items.map((_, index) => (
            <div class={`indicator w-12 h-1 bg-white/30 rounded-full overflow-hidden`}>
                <div class={`progress w-full h-full bg-white transform -translate-x-full transition-transform duration-[100ms] ${index === 0 ? 'active' : ''}`}></div>
            </div>
        ))}
    </div>
</div>

<script define:vars={{ interval, count: items.length, carouselId }}>
    const root = document.querySelector(`[data-carousel-id="${carouselId}"]`);

    if (!root) {
        throw new Error(`Carousel root not found: ${carouselId}`);
    }

    const carouselItems = root.querySelectorAll('.carousel-item');
    const indicators = root.querySelectorAll('.indicator .progress');
    let currentIndex = 0;
    let brokenItems = new Set(); // Track which items have errors
    let rotationTimer;
    let observer;
    
    // Setup error handlers for all videos and images
    function setupErrorHandlers() {
        carouselItems.forEach((item, index) => {
            const video = item.querySelector('.video-element');
            const image = item.querySelector('.image-element');
            const videoError = item.querySelector('.video-error');
            const imageError = item.querySelector('.image-error');
            
            if (video) {
                // Video error handler
                video.addEventListener('error', (e) => {
                    console.warn(`Video failed to load: ${item.dataset.src}`, e);
                    brokenItems.add(index);
                    video.classList.add('hidden');
                    if (videoError) {
                        videoError.classList.remove('hidden');
                    }
                    // If current item is broken, skip to next
                    if (index === currentIndex) {
                        setTimeout(() => nextSlide(), 1000);
                    }
                });
                
                // Video loaded successfully
                video.addEventListener('loadeddata', () => {
                    brokenItems.delete(index);
                });
                
                // Video stalled handler
                video.addEventListener('stalled', (e) => {
                    console.warn(`Video stalled: ${item.dataset.src}`);
                });
            }
            
            if (image) {
                // Image error handler
                image.addEventListener('error', (e) => {
                    console.warn(`Image failed to load: ${item.dataset.src}`, e);
                    brokenItems.add(index);
                    image.classList.add('hidden');
                    if (imageError) {
                        imageError.classList.remove('hidden');
                    }
                    // If current item is broken, skip to next
                    if (index === currentIndex) {
                        setTimeout(() => nextSlide(), 1000);
                    }
                });
                
                // Image loaded successfully
                image.addEventListener('load', () => {
                    brokenItems.delete(index);
                });
            }
        });
    }

    function nextSlide() {
        const prevIndex = currentIndex;
        let attempts = 0;
        const maxAttempts = count;
        
        // Find next non-broken item
        do {
            currentIndex = (currentIndex + 1) % count;
            attempts++;
            
            // If all items are broken, stop
            if (attempts >= maxAttempts) {
                console.error('All carousel items have errors');
                return;
            }
        } while (brokenItems.has(currentIndex));
        
        // Items transition
        carouselItems[prevIndex].classList.remove('opacity-100', 'z-10');
        carouselItems[prevIndex].classList.add('opacity-0', 'z-0');
        
        carouselItems[currentIndex].classList.remove('opacity-0', 'z-0');
        carouselItems[currentIndex].classList.add('opacity-100', 'z-10');
        
        // Video handling
        const prevVideo = carouselItems[prevIndex].querySelector('.video-element');
        const currentVideo = carouselItems[currentIndex].querySelector('.video-element');
        
        if (prevVideo) {
            prevVideo.pause();
        }
        
        if (currentVideo && !brokenItems.has(currentIndex)) {
            currentVideo.play().catch(e => {
                console.warn('Video play failed:', e);
                // Mark as broken and try next slide
                brokenItems.add(currentIndex);
                const videoError = carouselItems[currentIndex].querySelector('.video-error');
                const videoElement = carouselItems[currentIndex].querySelector('.video-element');
                if (videoElement) videoElement.classList.add('hidden');
                if (videoError) videoError.classList.remove('hidden');
                setTimeout(() => nextSlide(), 1000);
            });
        }

        // Reset progress bars
        indicators.forEach(ind => {
            ind.style.transform = 'translateX(-100%)';
            ind.style.transition = 'none';
        });
        
        startProgress(currentIndex);
    }

    function startProgress(index) {
        const bar = indicators[index];
        if (!bar) return;
        
        // Small delay to allow CSS transition reset
        requestAnimationFrame(() => {
            bar.style.transition = `transform ${interval}ms linear`;
            bar.style.transform = 'translateX(0)';
        });
        
    }

    function playCurrentVideo() {
        const currentVideo = carouselItems[currentIndex]?.querySelector('.video-element');
        if (currentVideo && !brokenItems.has(currentIndex)) {
            currentVideo.play().catch((e) => console.warn('Video play failed:', e));
        }
    }

    function pauseAllVideos() {
        carouselItems.forEach((item) => {
            const video = item.querySelector('.video-element');
            if (video) {
                video.pause();
            }
        });
    }

    function startRotation() {
        if (rotationTimer || count <= 1) {
            return;
        }

        rotationTimer = window.setInterval(nextSlide, interval);
    }

    function stopRotation() {
        if (rotationTimer) {
            window.clearInterval(rotationTimer);
            rotationTimer = undefined;
        }
    }

    // Init
    setupErrorHandlers();
    startProgress(0);
    playCurrentVideo();

    observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                playCurrentVideo();
                startRotation();
            } else {
                stopRotation();
                pauseAllVideos();
            }
        });
    }, { threshold: 0.35 });

    observer.observe(root);

    document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
            pauseAllVideos();
            stopRotation();
            return;
        }

        if (root.getBoundingClientRect().top < window.innerHeight && root.getBoundingClientRect().bottom > 0) {
            playCurrentVideo();
            startRotation();
        }
    });

</script>
