<div id="cmd-menu" class="fixed inset-0 z-50 bg-black/95 text-white flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300">
    <div class="text-center">
        <p class="text-neutral-500 mb-8 font-body tracking-widest text-xs uppercase">Command Menu</p>
        <nav class="flex flex-col space-y-8 font-display text-4xl md:text-6xl font-bold uppercase tracking-tight">
            <a href="#" class="menu-link hover:text-red-500 transition-colors">Manifesto</a>
            <a href="#projects" class="menu-link hover:text-red-500 transition-colors">Works</a>
            <a href="#services" class="menu-link hover:text-red-500 transition-colors">Services</a>
            <a href="#proof" class="menu-link hover:text-red-500 transition-colors">Proof</a>
            <a href="#partnerships" class="menu-link hover:text-red-500 transition-colors">Partners</a>
            <a href="#skills" class="menu-link hover:text-red-500 transition-colors">Skills</a>
            <a href="#contact" class="menu-link hover:text-red-500 transition-colors">Contact</a>
        </nav>
        <p class="mt-12 text-neutral-600 font-body text-sm">Press <span class="border border-neutral-600 px-2 py-1 rounded text-neutral-400">ESC</span> to closes</p>
    </div>
</div>

<script>
    const menu = document.getElementById('cmd-menu');
    let isOpen = false;

    function toggleMenu(show) {
        if (!menu) return;
        isOpen = show;
        if (show) {
            menu.style.opacity = '1';
            menu.style.pointerEvents = 'auto';
        } else {
            menu.style.opacity = '0';
            menu.style.pointerEvents = 'none';
        }
    }

    document.addEventListener('keydown', (e) => {
        if (e.key === '.') {
            toggleMenu(!isOpen);
        }
        if (e.key === 'Escape' && isOpen) {
            toggleMenu(false);
        }
    });

    // Close on link click
    if(menu) {
        const links = menu.querySelectorAll('.menu-link');
        links.forEach(link => {
            link.addEventListener('click', () => toggleMenu(false));
        });
    }
</script>
