---
interface Props {
    logos: { src: string; alt: string }[];
}

const { logos } = Astro.props;
---

<section class="logo-strip relative py-20 overflow-hidden bg-black/30">
    <!-- Subtle background glow -->
    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-red-500/3 to-transparent"></div>
    
    <!-- Logo scroller -->
    <div class="logo-track flex gap-16 items-center px-8">
        {logos.concat(logos).concat(logos).map((logo, index) => (
            <div 
                key={index} 
                class="logo-item flex-shrink-0 cursor-pointer group relative"
                data-magnetic
            >
                <img 
                    src={logo.src} 
                    alt={logo.alt}
                    class="logo-img w-32 h-20 object-contain filter grayscale brightness-75 opacity-40 group-hover:grayscale-0 group-hover:brightness-100 group-hover:opacity-100 transition-all duration-500"
                />
                
                <!-- Subtle glow on hover -->
                <div class="absolute inset-0 bg-red-500/0 group-hover:bg-red-500/10 blur-xl opacity-0 group-hover:opacity-100 transition-all duration-500 -z-10"></div>
            </div>
        ))}
    </div>
</section>

<script>
    import { gsap } from "gsap";
    
    // Infinite scroll animation
    const track = document.querySelector('.logo-track');
    if (track) {
        gsap.to(track, {
            x: '-33.33%', // Move by 1/3 since we have 3x logos
            duration: 40,
            ease: 'none',
            repeat: -1,
        });
        
        // Pause on hover
        track.addEventListener('mouseenter', () => {
            gsap.to(track, { timeScale: 0.2, duration: 0.5 });
        });
        
        track.addEventListener('mouseleave', () => {
            gsap.to(track, { timeScale: 1, duration: 0.5 });
        });
    }
    
    // Magnetic hover effect
    const logoItems = document.querySelectorAll('.logo-item[data-magnetic]');
    logoItems.forEach((item) => {
        item.addEventListener('mousemove', (e) => {
            const rect = item.getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;
            
            gsap.to(item, {
                x: x * 0.3,
                y: y * 0.3,
                duration: 0.4,
                ease: 'power2.out'
            });
        });
        
        item.addEventListener('mouseleave', () => {
            gsap.to(item, {
                x: 0,
                y: 0,
                duration: 0.6,
                ease: 'elastic.out(1, 0.5)'
            });
        });
        
        // Glitch effect on hover
        item.addEventListener('mouseenter', () => {
            const img = item.querySelector('.logo-img');
            
            gsap.timeline()
                .to(img, {
                    x: 3,
                    filter: 'hue-rotate(90deg)',
                    duration: 0.05,
                })
                .to(img, {
                    x: -3,
                    filter: 'hue-rotate(-90deg)',
                    duration: 0.05,
                })
                .to(img, {
                    x: 2,
                    duration: 0.05,
                })
                .to(img, {
                    x: 0,
                    filter: 'hue-rotate(0deg)',
                    duration: 0.1,
                });
        });
    });
</script>

<style>
    .logo-strip {
        position: relative;
        backdrop-filter: blur(5px);
    }
    
    .logo-track {
        will-change: transform;
    }
    
    .logo-item {
        will-change: transform;
    }
    
    .logo-img {
        will-change: filter, opacity;
        transition: filter 0.5s ease, opacity 0.5s ease, transform 0.1s ease;
    }
</style>
