# Copy to .env and fill in. Both are optional — the site works without them.

# Canonical site origin, used for absolute SEO tags (canonical, og:url) and to
# generate public/sitemap.xml at build time. Also accepted as SITE_URL.
#   VITE_SITE_URL=https://your-domain.com
VITE_SITE_URL=

# Formspree form ID — the part after /f/ in your form's action URL
# (create one free at https://formspree.io). When set, the /contact planner
# posts to a real form; when empty it composes a tidy email instead.
#   VITE_FORMSPREE_ID=abcdwxyz
VITE_FORMSPREE_ID=
